<Project>

  <!-- Applies to every project under this directory. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- What Windows shows in the executable's properties. The version is the release tag's
       (v1.2.3 gives 1.2.3, see .github/workflows/release.yml); a local build is 0.0.0-dev. -->
  <PropertyGroup>
    <Product>DySS Cockpit</Product>
    <Authors>Armand Delessert</Authors>
    <Company>Armand Delessert</Company>
    <Copyright>Copyright © 2026 Armand Delessert. Projet indépendant, non affilié à Dyson.</Copyright>
    <Version>0.0.0-dev</Version>
  </PropertyGroup>

</Project>
