<Window x:Class="MyDyson.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MyDyson.App.Controls"
        Title="Dyson Spot+Scrub AI" Width="1180" Height="800" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e22" Foreground="White" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Background" Value="#3a6ea5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#3a3a40"/>
                    <Setter Property="Foreground" Value="#888"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- Themed controls (ScrollViewer, TabControl, ListView…) reset the inherited Foreground to
             the system text colour, so every TextBlock gets its colour explicitly. -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Label" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="#9a9aa4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Section" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style TargetType="ListView">
            <Setter Property="Background" Value="#26262c"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#26262c"/>
            <Setter Property="Foreground" Value="#ccc"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="#26262c" Padding="16,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#e05050"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Connected}" Value="True">
                                        <Setter Property="Fill" Value="#3cb43c"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding Connection}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding LastUpdate, StringFormat='mis à jour {0}'}" Foreground="#9a9aa4" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding RobotName}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Foreground="#9a9aa4">
                        <Run Text="{Binding Serial, Mode=OneWay}"/> · firmware <Run Text="{Binding Firmware, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#26262c" Padding="16,6">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right" Width="120" Height="4" IsIndeterminate="True" Visibility="{Binding Busy, Converter={StaticResource Show}}"/>
                <TextBlock Text="{Binding Message}" Foreground="#f0c674"/>
            </DockPanel>
        </Border>

        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Left column: state and controls -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Foreground="White">
                <StackPanel>
                    <TextBlock Text="{Binding StateText}" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="{Binding ActionText}" Foreground="#9a9aa4"/>
                    <TextBlock Text="{Binding DockText, StringFormat='Station : {0}'}" Foreground="#9a9aa4"
                               Visibility="{Binding IsDrying, Converter={StaticResource Show}}"/>
                    <TextBlock Text="{Binding FaultText}" Foreground="#e05050" FontWeight="SemiBold" TextWrapping="Wrap"
                               Visibility="{Binding HasRealFault, Converter={StaticResource Show}}"/>

                    <TextBlock Text="Batterie" Style="{StaticResource Label}"/>
                    <Grid>
                        <ProgressBar Value="{Binding Battery, Mode=OneWay}" Maximum="100" Height="18" Foreground="#3cb43c" Background="#2a2a30" BorderThickness="0"/>
                        <TextBlock Text="{Binding Battery, StringFormat='{}{0} %'}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="White"/>
                    </Grid>

                    <TextBlock Text="Commandes" Style="{StaticResource Label}"/>
                    <WrapPanel>
                        <Button Content="▶ Nettoyer la sélection" Command="{Binding StartCleanCommand}" IsEnabled="{Binding CanStart}"/>
                        <Button Content="⏸ Pause" Command="{Binding PauseCommand}" IsEnabled="{Binding CanPause}"/>
                        <Button Content="⌂ Retour station" Command="{Binding AbortCommand}" IsEnabled="{Binding CanAbort}"/>
                        <Button Content="Arrêter le séchage" Command="{Binding StopDryingCommand}" IsEnabled="{Binding IsDrying}"/>
                        <Button Content="Vider le bac" Command="{Binding CollectDustCommand}"/>
                        <Button Content="↻ Actualiser" Command="{Binding RefreshCommand}"/>
                    </WrapPanel>

                    <TextBlock Style="{StaticResource Label}">
                        <Run Text="Pièces de la carte"/> <Run Text="{Binding CurrentMapName, Mode=OneWay}"/>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Zones}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Selected}" Foreground="White">
                                    <TextBlock Foreground="White">
                                        <Run Text="{Binding Name, Mode=OneWay}"/>
                                        <Run Text="{Binding Area, Mode=OneWay, StringFormat='({0:F1} m²)'}" Foreground="#9a9aa4"/>
                                    </TextBlock>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Consommables" Style="{StaticResource Label}"/>
                    <ItemsControl ItemsSource="{Binding Consumables}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="White"/>
                                    <ProgressBar Grid.Column="1" Value="{Binding Bar, Mode=OneWay}" Maximum="100" Height="8" Foreground="#d6a76c" Background="#2a2a30" BorderThickness="0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Display}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#9a9aa4"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Right column: tabs -->
            <TabControl x:Name="Tabs" Grid.Column="2" Background="#1e1e22" BorderThickness="0" Foreground="White">
                <TabItem Header="Carte">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="0,8,0,0">
                            <Button Content="Exporter en PNG" Command="{Binding ExportMapCommand}"/>
                            <TextBlock Text="Cochez des pièces à gauche pour les mettre en avant. Le tracé affiché est celui du nettoyage sélectionné dans l'historique, sinon le dernier." Foreground="#9a9aa4" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520"/>
                        </WrapPanel>
                        <controls:MapView Scene="{Binding Scene}" Margin="0,8,0,0"/>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Historique">
                    <ListView ItemsSource="{Binding History}" SelectedItem="{Binding SelectedClean}" Margin="0,8,0,0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Date" Width="140" DisplayMemberBinding="{Binding When}"/>
                                <GridViewColumn Header="Durée" Width="80" DisplayMemberBinding="{Binding Duration}"/>
                                <GridViewColumn Header="Surface" Width="90" DisplayMemberBinding="{Binding Area}"/>
                                <GridViewColumn Header="Batterie" Width="110" DisplayMemberBinding="{Binding Battery}"/>
                                <GridViewColumn Header="Fautes" Width="90" DisplayMemberBinding="{Binding Faults}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </TabItem>

                <TabItem Header="Réglages">
                    <StackPanel Margin="8,16" MaxWidth="480" HorizontalAlignment="Left">
                        <TextBlock Text="Station" Style="{StaticResource Section}"/>
                        <CheckBox Content="Eau chaude pour la serpillière" IsChecked="{Binding HotWaterMop}"/>
                        <CheckBox Content="Chauffe-eau de la station" IsChecked="{Binding HotWaterSwitch}"/>
                        <CheckBox Content="Détergent" IsChecked="{Binding Detergent}"/>

                        <TextBlock Style="{StaticResource Label}">
                            <Run Text="Rinçage de la serpillière :"/> <Run Text="{Binding BackWashText, Mode=OneWay}"/>
                        </TextBlock>
                        <WrapPanel>
                            <Button Content="Après chaque pièce" Command="{Binding BackWashPerRoomCommand}"/>
                            <Button Content="Toutes les 15 min" Command="{Binding BackWashEvery15Command}"/>
                            <Button Content="Toutes les 30 min" Command="{Binding BackWashEvery30Command}"/>
                        </WrapPanel>

                        <TextBlock Text="Intensité du séchage" Style="{StaticResource Label}"/>
                        <StackPanel Orientation="Horizontal">
                            <Slider Value="{Binding AirDryFrequency}" Minimum="3" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" Width="160" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding AirDryFrequency}" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="White"/>
                        </StackPanel>

                        <TextBlock Text="Robot" Style="{StaticResource Section}" Margin="0,24,0,8"/>
                        <CheckBox Content="Sons" IsChecked="{Binding Alarm}"/>
                        <TextBlock Text="Volume" Style="{StaticResource Label}"/>
                        <StackPanel Orientation="Horizontal">
                            <Slider Value="{Binding Volume}" Minimum="0" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" Width="200" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Volume}" Margin="10,0,10,0" VerticalAlignment="Center" Width="30" Foreground="White"/>
                            <Button Content="Appliquer" Command="{Binding ApplyVolumeCommand}" Margin="0"/>
                        </StackPanel>
                        <TextBlock Text="Chaque réglage est envoyé au robot immédiatement, dans les deux dialectes, comme le fait l'application officielle." Foreground="#9a9aa4" TextWrapping="Wrap" Margin="0,16,0,0"/>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Journal">
                    <ListBox ItemsSource="{Binding Log}" FontFamily="Consolas" FontSize="12" Margin="0,8,0,0"/>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
