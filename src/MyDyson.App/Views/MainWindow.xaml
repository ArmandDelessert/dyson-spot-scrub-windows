<Window x:Class="MyDyson.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MyDyson.App.Controls"
        xmlns:vm="clr-namespace:MyDyson.App.ViewModels"
        Title="Dyson Spot+Scrub AI" Width="1240" Height="820" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <ResourceDictionary Source="/Themes/Controls.xaml"/>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" Padding="16,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Hub.Connected}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding Hub.Connection}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding Status.LastUpdate, StringFormat='mis à jour {0}'}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="↻ Actualiser" Command="{Binding RefreshCommand}" Style="{StaticResource Secondary}" Margin="0,0,8,0"/>
                    <Button Content="Se déconnecter" Command="{Binding LogoutCommand}" Style="{StaticResource Secondary}" Margin="0"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding RobotName}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Muted}">
                        Numéro de série <Run Text="{Binding Serial, Mode=OneWay}"/> · Firmware <Run Text="{Binding Firmware, Mode=OneWay}"/> · Compte <Run Text="{Binding AccountEmail, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBrush}" Padding="16,6">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right" Width="120" Height="4" IsIndeterminate="True" Visibility="{Binding Hub.Busy, Converter={StaticResource Show}}"/>
                <TextBlock Text="{Binding Hub.Message}" Foreground="{DynamicResource DangerBrush}"/>
            </DockPanel>
        </Border>

        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Left column -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Foreground="{DynamicResource TextBrush}">
                <StackPanel Margin="0,0,8,0">

                    <!-- State -->
                    <Border Style="{StaticResource Card}" DataContext="{Binding Status}">
                        <StackPanel>
                            <TextBlock Text="{Binding StateText}" FontSize="19" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ActionText}" Style="{StaticResource Muted}"/>
                            <TextBlock Text="Retour à la station pour laver le rouleau humide" Style="{StaticResource Muted}"
                                       Visibility="{Binding ReturningToWash, Converter={StaticResource Show}}"/>
                            <TextBlock Text="{Binding DockText}" Style="{StaticResource Muted}"
                                       Visibility="{Binding DockBusy, Converter={StaticResource Show}}"/>
                            <TextBlock Text="{Binding FaultText}" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Visibility="{Binding HasRealFault, Converter={StaticResource Show}}"/>
                            <Grid Margin="0,10,0,0">
                                <ProgressBar Value="{Binding Battery, Mode=OneWay}" AutomationProperties.Name="Batterie" Maximum="100" Height="18" Foreground="{DynamicResource SuccessBrush}" Background="{DynamicResource CardBrush}" BorderThickness="0"/>
                                <TextBlock Text="{Binding Battery, StringFormat='{}{0} %'}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                            </Grid>
                            <WrapPanel Margin="0,12,0,-8">
                                <Button Content="{Binding PauseResumeLabel}" Command="{Binding PauseResumeCommand}" IsEnabled="{Binding CanPause}" Style="{StaticResource Secondary}"/>
                                <Button Content="⌂ Retour à la station" Command="{Binding AbortCommand}" IsEnabled="{Binding CanAbort}" Style="{StaticResource Secondary}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Clean -->
                    <Border Style="{StaticResource Card}" DataContext="{Binding Cleaning}">
                        <StackPanel>
                            <TextBlock Text="Nettoyage" Style="{StaticResource Section}"/>
                            <TextBlock Text="Carte" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                            <!-- The picker gets the full width; its two actions sit underneath, which
                                 leaves the map names readable however long they are. -->
                            <ComboBox ItemsSource="{Binding Maps}" SelectedItem="{Binding SelectedMap}">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                            <WrapPanel Margin="0,0,0,-8">
                                <Button Content="Définir comme active" Command="{Binding SetActiveMapCommand}"
                                        IsEnabled="{Binding SelectedMap.Metadata.IsCurrentMap, Converter={StaticResource Not}}"
                                        Style="{StaticResource Secondary}"/>
                                <Button Content="Gérer les cartes…" Style="{StaticResource Secondary}"
                                        ToolTip="Renommer les cartes et les pièces, fusionner ou diviser des pièces, lancer une cartographie"
                                        Command="{Binding DataContext.ManageMapsCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </WrapPanel>
                            <TextBlock Text="Pièces, dans l'ordre de passage souhaité. Cochez-les ici ou cliquez-les sur la carte. Cliquez une pièce cochée pour replier ou déplier ses réglages." Style="{StaticResource Label}" TextWrapping="Wrap"/>

                            <!-- Explains the four per-room controls once, rather than repeating a full
                                 sentence under each of them for every room in the list. -->
                            <StackPanel Margin="0,6,0,8">
                                <TextBlock Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap">
                                    <Run FontWeight="SemiBold" Text="Type de nettoyage : "/><Run Text="ce que le robot doit faire dans la pièce."/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0">
                                    <Run FontWeight="SemiBold" Text="Mode d'aspiration : "/><Run Text="définissez le mode d'aspiration utilisé pour nettoyer le sol."/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0">
                                    <Run FontWeight="SemiBold" Text="Niveau d'hydratation : "/><Run Text="définissez la quantité d'eau que votre robot utilise pour laver le sol."/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0">
                                    <Run FontWeight="SemiBold" Text="Répétitions de lavage : "/><Run Text="définissez combien de passages votre robot doit effectuer pour laver le sol."/>
                                </TextBlock>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Zones}" ItemTemplate="{StaticResource RoomSettingsRow}" IsEnabled="{Binding RoomsEnabled}"/>
                            <!-- Disabled until a room is ticked and the robot can take a job. The
                                 tooltip shows while disabled (WPF hides tooltips there by default),
                                 which is what turns a dead button into an explanation. -->
                            <Button Content="▶ Nettoyer la sélection" Command="{Binding StartCleanCommand}" IsEnabled="{Binding CanStart}"
                                    Margin="0,10,0,0" HorizontalAlignment="Left" ToolTipService.ShowOnDisabled="True">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="ToolTip" Value="Lance le nettoyage des pièces cochées, dans l'ordre indiqué."/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanStart}" Value="False">
                                                <Setter Property="ToolTip" Value="Cochez au moins une pièce, sans zone tracée ; le robot doit aussi être disponible."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- A rectangle drawn on the map instead of whole rooms, as the phone's zone clean. -->
                            <TextBlock Text="Nettoyer une zone" Style="{StaticResource Section}" Margin="0,16,0,4"/>
                            <TextBlock Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap">
                                Tracez un rectangle sur la carte en cliquant deux coins opposés, choisissez comment le nettoyer, puis lancez : le robot ne nettoie que cette zone. Faites-la glisser pour la déplacer, tirez ses coins pour la redimensionner ; un clic dans le vide de la carte l'efface. Tant qu'une zone est tracée, les pièces ne peuvent pas être cochées.
                            </TextBlock>
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="{Binding DrawSpotLabel}" Command="{Binding DrawSpotCommand}" Style="{StaticResource Secondary}"/>
                                <Button Content="Effacer la zone" Command="{Binding ClearSpotCommand}" Style="{StaticResource Secondary}"
                                        Visibility="{Binding HasSpot, Converter={StaticResource Show}}"/>
                            </WrapPanel>
                            <StackPanel Visibility="{Binding HasSpot, Converter={StaticResource Show}}">
                                <TextBlock Text="{Binding SpotSizeText}" Style="{StaticResource Muted}"/>
                                <ComboBox ItemsSource="{Binding SpotCleanTypes}" SelectedItem="{Binding SpotCleanType}" FontSize="12" Margin="0,4,0,0"
                                          AutomationProperties.Name="Type de nettoyage de la zone">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <ComboBox ItemsSource="{Binding SpotStrategies}" SelectedItem="{Binding SpotStrategy}" FontSize="12" Margin="0,4,0,0"
                                          Visibility="{Binding SpotHasVacuum, Converter={StaticResource Show}}" AutomationProperties.Name="Mode d'aspiration de la zone">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <Grid Margin="0,4,0,0" Visibility="{Binding SpotHasMop, Converter={StaticResource Show}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding SpotWaterLevels}" SelectedItem="{Binding SpotWaterLevel}" FontSize="12" Margin="0"
                                              AutomationProperties.Name="Niveau d'eau de la zone">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding SpotMopPasses}" SelectedItem="{Binding SpotMopPass}" FontSize="12" Margin="0"
                                              AutomationProperties.Name="Passages de lavage de la zone">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                                <Button Content="▶ Nettoyer la zone" Command="{Binding StartSpotCleanCommand}" IsEnabled="{Binding CanStartSpot}"
                                        Margin="0,10,0,0" HorizontalAlignment="Left" ToolTipService.ShowOnDisabled="True"
                                        ToolTip="Le robot doit être disponible (sur sa station ou à l'arrêt)."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Dock -->
                    <Border Style="{StaticResource Card}" DataContext="{Binding Status}">
                        <StackPanel>
                            <TextBlock Text="Station" Style="{StaticResource Section}"/>
                            <WrapPanel Margin="0,0,0,-8">
                                <Button Content="Vider le collecteur" Command="{Binding CollectDustCommand}" Style="{StaticResource Secondary}"/>
                                <Button Content="{Binding WashDryLabel}" Command="{Binding WashDryCommand}" Style="{StaticResource Secondary}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Consumables -->
                    <Border Style="{StaticResource Card}" DataContext="{Binding Status}">
                        <StackPanel>
                            <TextBlock Text="Consommables" Style="{StaticResource Section}"/>
                            <TextBlock Text="Durée de vie restante. À remplacer à 0 %." Style="{StaticResource Muted}" FontSize="11" Margin="0,-4,0,8"/>
                            <ItemsControl ItemsSource="{Binding Consumables}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="70"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                            <ProgressBar Grid.Column="1" Value="{Binding Remaining, Mode=OneWay}" AutomationProperties.Name="{Binding Name}" Maximum="100" Height="8" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource CardBrush}" BorderThickness="0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Display}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Muted}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Right column: tabs -->
            <TabControl x:Name="Tabs" Grid.Column="2" Foreground="{DynamicResource TextBrush}">
                <TabItem Header="Carte" DataContext="{Binding Cleaning}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,8,0,8">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <!-- Display preferences sit with the map they change, rather than in
                                     the Réglages tab, where everything else is sent to the robot.
                                     They apply to the history map too. -->
                                <!-- While the panel is open the toggle ignores the mouse: the click that
                                     lands on it then only closes the panel (StaysOpen="False"), where it
                                     used to close it and immediately reopen it through the toggle. -->
                                <ToggleButton x:Name="DisplayOptionsButton" Content="Affichage ▾"
                                              IsHitTestVisible="{Binding IsOpen, ElementName=DisplayOptionsPopup, Converter={StaticResource Not}}" Margin="0,0,8,0" Padding="10,4" Cursor="Hand"
                                              AutomationProperties.Name="Options d'affichage de la carte"
                                              Style="{StaticResource ToolbarToggle}"/>
                                <Popup x:Name="DisplayOptionsPopup" IsOpen="{Binding IsChecked, ElementName=DisplayOptionsButton, Mode=TwoWay}" StaysOpen="False"
                                       PlacementTarget="{Binding ElementName=DisplayOptionsButton}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12,10">
                                        <StackPanel DataContext="{Binding Display}">
                                            <CheckBox IsChecked="{Binding ShowFurniture}" Content="Afficher les meubles"/>
                                            <CheckBox IsChecked="{Binding ShowTravelPath}" Content="Afficher les déplacements sans nettoyage"/>
                                            <CheckBox IsChecked="{Binding ShowExportButton}" Content="Afficher le bouton d'export PNG"/>
                                            <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" MaxWidth="260">
                                                Ces réglages ne concernent que cet affichage : rien n'est envoyé au robot.
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                                <Button Content="Réinitialiser le zoom" Click="ResetZoom_Click" Style="{StaticResource Secondary}" Margin="0,0,8,0"/>
                                <Button Content="Exporter en PNG" Command="{Binding ExportMapCommand}" Style="{StaticResource Secondary}" Margin="0"
                                        Visibility="{Binding Display.ShowExportButton, Converter={StaticResource Show}}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap">
                                Clic/tape : sélectionne une pièce, efface la sélection en dehors. Double-clic/double-tape en dehors : réinitialise le zoom. Molette ou pincement pour zoomer, glisser pour déplacer.
                            </TextBlock>
                        </DockPanel>
                        <controls:MapView x:Name="MapCanvas" Scene="{Binding Scene}" AutomationProperties.Name="Carte de la maison"/>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Historique" DataContext="{Binding History}">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="220"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <ListView ItemsSource="{Binding History}" SelectedItem="{Binding SelectedClean}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Date" Width="140" DisplayMemberBinding="{Binding When}"/>
                                    <GridViewColumn Header="Durée" Width="130">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Duration}" Width="85" Style="{StaticResource NumericCell}"/></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Fin" Width="140" DisplayMemberBinding="{Binding End}"/>
                                    <GridViewColumn Header="Carte" Width="130" DisplayMemberBinding="{Binding MapName}"/>
                                    <GridViewColumn Header="Pièces" Width="200" DisplayMemberBinding="{Binding Rooms}"/>
                                    <GridViewColumn Header="Surface" Width="120">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Area}" Width="80" Style="{StaticResource NumericCell}"/></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Batterie" Width="110" DisplayMemberBinding="{Binding Battery}"/>
                                    <GridViewColumn Header="Fautes" Width="60" DisplayMemberBinding="{Binding Faults}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" Background="Transparent"/>
                        <DockPanel Grid.Row="2">
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Réinitialiser le zoom" Click="ResetHistoryZoom_Click" Style="{StaticResource Secondary}" Margin="0"/>
                                    <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center">
                                        <Run Text="Trajet du nettoyage sélectionné sur la carte "/><Run Text="{Binding MapName, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="."/>
                                    </TextBlock>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap">
                                    <Run Text="Résultat : "/><Run Text="{Binding ResultText, Mode=OneWay}" FontWeight="SemiBold"/>
                                </TextBlock>
                            </StackPanel>
                            <controls:MapView x:Name="HistoryCanvas" Scene="{Binding Scene}" AutomationProperties.Name="Trajet du nettoyage sélectionné"/>
                        </DockPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Horaires" DataContext="{Binding Schedules}">
                    <DockPanel Margin="0,8,0,0">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="{Binding Heading}" Style="{StaticResource Section}"/>
                            <TextBlock Style="{StaticResource Muted}" FontSize="11">
                                Les horaires de la carte active, tels que le cloud Dyson les garde : ceux créés ici comme ceux de l'application mobile.
                                Le robot n'exécute que ceux de la carte active ; ceux des autres cartes réapparaissent quand elle le redevient.
                            </TextBlock>
                            <WrapPanel Margin="0,10,0,2">
                                <Button Content="Nouvel horaire…" Command="{Binding NewCommand}" ToolTipService.ShowOnDisabled="True"
                                        ToolTip="Planifie un nettoyage de la carte active ; le robot doit être connecté."/>
                            </WrapPanel>
                            <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Muted}" Margin="0,8,0,0"
                                       Visibility="{Binding EmptyText, Converter={StaticResource Show}}"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Items}" AutomationProperties.Name="Horaires de la carte active">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ScheduleItem}">
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                            <DockPanel>
                                                <!-- Checked means the robot will run it; unticking sends the same schedule with enable 0. -->
                                                <CheckBox DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,4,10,0"
                                                          IsChecked="{Binding Enabled, Mode=OneWay}"
                                                          Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          CommandParameter="{Binding}"
                                                          AutomationProperties.Name="{Binding TimeText, StringFormat='Horaire de {0} activé'}"/>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                                    <Button Content="Modifier…" Style="{StaticResource Secondary}"
                                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="Supprimer…" Style="{StaticResource Secondary}"
                                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock>
                                                        <Run Text="{Binding TimeText, Mode=OneWay}" FontSize="17" FontWeight="SemiBold"/>
                                                        <Run Text="  "/>
                                                        <Run Text="{Binding DaysText, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding RoomsText}" Style="{StaticResource Muted}"/>
                                                    <TextBlock Text="{Binding DurationText}" Style="{StaticResource Muted}" FontSize="11"/>
                                                    <TextBlock Text="{Binding OverlapText}" Foreground="{DynamicResource DangerBrush}" FontSize="11" TextWrapping="Wrap"
                                                               Visibility="{Binding OverlapText, Converter={StaticResource Show}}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Réglages" DataContext="{Binding Settings}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                            <TextBlock Text="Réglages de lavage" Style="{StaticResource Section}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding HotWaterMop}" FontWeight="SemiBold" Content="Laver à l'eau chaude"/>
                                    <TextBlock Text="Idéal pour les nettoyages en profondeur, déconseillé pour les parquets ou stratifiés." Style="{StaticResource Muted}" Margin="20,0,0,10"/>
                                    <CheckBox IsChecked="{Binding Detergent}" FontWeight="SemiBold" Content="Laver avec le produit de nettoyage"/>
                                    <TextBlock Text="Votre robot lavera le sol avec le produit de nettoyage dans la station." Style="{StaticResource Muted}" Margin="20,0,0,10"/>
                                    <DockPanel Margin="0,4,0,0">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding SolutionStatus}" Style="{StaticResource Muted}"/>
                                        <TextBlock Text="Produit de nettoyage" FontWeight="SemiBold"/>
                                    </DockPanel>
                                    <TextBlock Text="Indique s'il reste suffisamment de produit dans la station." Style="{StaticResource Muted}" Margin="0,0,0,10"/>
                                    <CheckBox IsChecked="{Binding WashMopBeforeClean}" FontWeight="SemiBold" Content="Prolonger les préparatifs de lavage"/>
                                    <TextBlock Text="Garantit une couverture de nettoyage homogène en consacrant plus de temps à la préparation sur la station d'accueil." Style="{StaticResource Muted}" Margin="20,0,0,0"/>
                                    <TextBlock Text="Le robot ne communique pas encore cet état. Cette case reflète donc le dernier choix fait ici." Style="{StaticResource Muted}" FontSize="11" Margin="20,2,0,0"
                                               Visibility="{Binding WashMopBeforeCleanKnown, Converter={StaticResource Collapse}}"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Réglages station" Style="{StaticResource Section}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Intervalle d'auto-nettoyage" FontWeight="SemiBold"/>
                                    <TextBlock Text="Définissez la fréquence à laquelle votre robot revient nettoyer son rouleau humide ou vider le collecteur pendant le nettoyage." Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding BackWashOptions}" SelectedItem="{Binding BackWash}" Width="260" HorizontalAlignment="Left">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="{Binding BackWash.Description}" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
                                    <CheckBox IsChecked="{Binding HotWaterSwitch}" FontWeight="SemiBold" Content="S'autonettoie à l'eau chaude" Margin="0,0,0,10"/>
                                    <TextBlock Text="Durée de séchage sur rouleau humide" FontWeight="SemiBold"/>
                                    <ComboBox ItemsSource="{Binding DryOptions}" SelectedItem="{Binding DryDuration}" Width="260" HorizontalAlignment="Left">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="{Binding DryDuration.Description}" Style="{StaticResource Muted}"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Réglages vocaux du robot" Style="{StaticResource Section}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding Alarm}" FontWeight="SemiBold" Content="Activer les commandes vocales du robot" Margin="0,0,0,10"/>
                                    <TextBlock Text="Volume" FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Slider Value="{Binding Volume}" AutomationProperties.Name="Volume" Minimum="0" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" Width="200" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Volume}" Margin="10,0,10,0" VerticalAlignment="Center" Width="30"/>
                                        <Button Content="Appliquer" Command="{Binding ApplyVolumeCommand}" Margin="0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Chaque réglage est envoyé au robot immédiatement, comme le fait l'application officielle." Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Journal" DataContext="{Binding Journal}">
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10">
                            Le journal affiche les événements notables signalés par le robot (fautes, fin de nettoyage, changement de carte…) et le résultat des commandes envoyées depuis cette fenêtre. Il ne montre pas chaque message échangé avec le robot : cochez la case ci-dessous pour tous les enregistrer, un fichier par jour, gardé 30 jours. Cela aide à repérer des messages encore non identifiés.
                        </TextBlock>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="Ouvrir le dossier" Command="{Binding OpenRecordFolderCommand}" Style="{StaticResource Secondary}"
                                    Margin="10,0,0,0" ToolTip="{Binding RecordFolder}"/>
                            <CheckBox IsChecked="{Binding RecordMessages}" Content="Enregistrer tous les messages" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding RecordInfo}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <ListBox ItemsSource="{Binding Log}" FontFamily="Consolas" FontSize="12"/>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
