<Window x:Class="MyDyson.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MyDyson.App.Controls"
        xmlns:vm="clr-namespace:MyDyson.App.ViewModels"
        Title="Dyson Spot+Scrub AI" Width="1240" Height="820" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <!-- Themed controls reset the inherited Foreground, so every text gets it explicitly. -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Label" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Muted" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Section" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource DisabledBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button" x:Key="Secondary" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- ComboBox with theme colours; the stock template ignores Background in dark mode. -->
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,2,0,6"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding ItemTemplate}"
                                              Margin="8,0,26,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                              TextElement.Foreground="{DynamicResource TextBrush}"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{DynamicResource TextBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListView">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="4,3"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}" Margin="0,0,4,0">
                            <ContentPresenter ContentSource="Header" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" Padding="16,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Connected}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding Connection}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding LastUpdate, StringFormat='mis à jour {0}'}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="↻ Actualiser" Command="{Binding RefreshCommand}" Style="{StaticResource Secondary}" Margin="0,0,8,0"/>
                    <Button Content="Se déconnecter" Command="{Binding LogoutCommand}" Style="{StaticResource Secondary}" Margin="0"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding RobotName}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Muted}">
                        <Run Text="{Binding Serial, Mode=OneWay}"/> · firmware <Run Text="{Binding Firmware, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBrush}" Padding="16,6">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right" Width="120" Height="4" IsIndeterminate="True" Visibility="{Binding Busy, Converter={StaticResource Show}}"/>
                <TextBlock Text="{Binding Message}" Foreground="{DynamicResource DangerBrush}"/>
            </DockPanel>
        </Border>

        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Left column -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Foreground="{DynamicResource TextBrush}">
                <StackPanel Margin="0,0,8,0">

                    <!-- State -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{Binding StateText}" FontSize="19" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ActionText}" Style="{StaticResource Muted}"/>
                            <TextBlock Text="{Binding DockText}" Style="{StaticResource Muted}"
                                       Visibility="{Binding DockBusy, Converter={StaticResource Show}}"/>
                            <TextBlock Text="{Binding FaultText}" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Visibility="{Binding HasRealFault, Converter={StaticResource Show}}"/>
                            <Grid Margin="0,10,0,0">
                                <ProgressBar Value="{Binding Battery, Mode=OneWay}" Maximum="100" Height="18" Foreground="{DynamicResource SuccessBrush}" Background="{DynamicResource CardBrush}" BorderThickness="0"/>
                                <TextBlock Text="{Binding Battery, StringFormat='{}{0} %'}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                            </Grid>
                            <WrapPanel Margin="0,12,0,-8">
                                <Button Content="⏸ Pause" Command="{Binding PauseCommand}" IsEnabled="{Binding CanPause}" Style="{StaticResource Secondary}"/>
                                <Button Content="⌂ Retour à la station" Command="{Binding AbortCommand}" IsEnabled="{Binding CanAbort}" Style="{StaticResource Secondary}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Clean -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Nettoyage" Style="{StaticResource Section}"/>
                            <TextBlock Text="Carte" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Définir comme active" Command="{Binding SetActiveMapCommand}"
                                        IsEnabled="{Binding SelectedMap.Metadata.IsCurrentMap, Converter={StaticResource Not}}"
                                        Style="{StaticResource Secondary}" Margin="8,0,0,0"/>
                                <ComboBox ItemsSource="{Binding Maps}" SelectedItem="{Binding SelectedMap}">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                            </DockPanel>
                            <TextBlock Text="Pièces, dans l'ordre de passage souhaité. Cochez-les ici ou cliquez-les sur la carte. Cliquez une pièce cochée pour replier ou déplier ses réglages." Style="{StaticResource Label}" TextWrapping="Wrap"/>

                            <!-- Explains the four per-room controls once, rather than repeating a full
                                 sentence under each of them for every room in the list. -->
                            <StackPanel Margin="0,6,0,8">
                                <TextBlock Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap">
                                    <Run FontWeight="SemiBold" Text="Type de nettoyage : "/><Run Text="ce que le robot doit faire dans la pièce."/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0">
                                    <Run FontWeight="SemiBold" Text="Mode d'aspiration : "/><Run Text="définissez le mode d'aspiration utilisé pour nettoyer le sol."/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0">
                                    <Run FontWeight="SemiBold" Text="Niveau d'hydratation : "/><Run Text="définissez la quantité d'eau que votre robot utilise pour laver le sol."/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0">
                                    <Run FontWeight="SemiBold" Text="Répétitions de lavage : "/><Run Text="définissez combien de passages votre robot doit effectuer pour laver le sol."/>
                                </TextBlock>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Zones}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ZoneItem}">
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6" Margin="0,0,0,2">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="22"/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding OrderText}" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                                                    <CheckBox Grid.Column="1" IsChecked="{Binding Selected}">
                                                        <TextBlock TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding DisplayName, Mode=OneWay}"/>
                                                            <Run Text="{Binding Area, Mode=OneWay, StringFormat='({0:F1} m²)'}" Foreground="{DynamicResource MutedBrush}"/>
                                                        </TextBlock>
                                                    </CheckBox>
                                                    <ToggleButton Grid.Column="2" IsChecked="{Binding IsExpanded}" Width="22" Height="20" Padding="0" Cursor="Hand">
                                                        <ToggleButton.Style>
                                                            <Style TargetType="ToggleButton">
                                                                <Setter Property="Content" Value="▸"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="ToggleButton">
                                                                            <Border Background="Transparent">
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                                  TextElement.Foreground="{DynamicResource MutedBrush}"/>
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter Property="Content" Value="▾"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ToggleButton.Style>
                                                    </ToggleButton>
                                                </Grid>

                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="11" Margin="22,2,0,0"
                                                           Visibility="{Binding IsExpanded, Converter={StaticResource Collapse}}"/>

                                                <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource Show}}">
                                                    <ComboBox ItemsSource="{x:Static vm:ZoneItem.CleanTypeOptions}" SelectedItem="{Binding SelectedCleanType}" FontSize="12" Margin="22,4,0,0">
                                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <ComboBox ItemsSource="{x:Static vm:ZoneItem.StrategyOptions}" SelectedItem="{Binding SelectedStrategy}" FontSize="12" Margin="22,4,0,0"
                                                              Visibility="{Binding HasVacuum, Converter={StaticResource Show}}">
                                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <Grid Margin="22,4,0,0" Visibility="{Binding HasMop, Converter={StaticResource Show}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition/>
                                                        </Grid.ColumnDefinitions>
                                                        <ComboBox ItemsSource="{x:Static vm:ZoneItem.WaterLevelOptions}" SelectedItem="{Binding SelectedWaterLevel}" FontSize="12" Margin="0">
                                                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                        <ComboBox Grid.Column="2" ItemsSource="{x:Static vm:ZoneItem.MopPassesOptions}" SelectedItem="{Binding SelectedMopPasses}" FontSize="12" Margin="0">
                                                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="▶ Nettoyer la sélection" Command="{Binding StartCleanCommand}" IsEnabled="{Binding CanStart}" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <!-- Dock -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Station" Style="{StaticResource Section}"/>
                            <WrapPanel Margin="0,0,0,-8">
                                <Button Content="Vider le collecteur" Command="{Binding CollectDustCommand}" Style="{StaticResource Secondary}"/>
                                <Button Content="{Binding WashDryLabel}" Command="{Binding WashDryCommand}" Style="{StaticResource Secondary}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Consumables -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Consommables" Style="{StaticResource Section}"/>
                            <TextBlock Text="Durée de vie restante. À remplacer à 0 %." Style="{StaticResource Muted}" FontSize="11" Margin="0,-4,0,8"/>
                            <ItemsControl ItemsSource="{Binding Consumables}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="70"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                            <ProgressBar Grid.Column="1" Value="{Binding Remaining, Mode=OneWay}" Maximum="100" Height="8" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource CardBrush}" BorderThickness="0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Display}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Muted}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Right column: tabs -->
            <TabControl x:Name="Tabs" Grid.Column="2" Foreground="{DynamicResource TextBrush}">
                <TabItem Header="Carte">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,8,0,8">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Content="Réinitialiser le zoom" Click="ResetZoom_Click" Style="{StaticResource Secondary}" Margin="0,0,8,0"/>
                                <Button Content="Exporter en PNG" Command="{Binding ExportMapCommand}" Style="{StaticResource Secondary}" Margin="0"/>
                            </StackPanel>
                            <TextBlock Text="Cliquez une pièce pour la sélectionner, molette pour zoomer, glissez pour déplacer." Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <controls:MapView x:Name="MapCanvas" Scene="{Binding Scene}"/>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Historique">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="220"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <ListView ItemsSource="{Binding History}" SelectedItem="{Binding SelectedClean}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Date" Width="140" DisplayMemberBinding="{Binding When}"/>
                                    <GridViewColumn Header="Durée" Width="80" DisplayMemberBinding="{Binding Duration}"/>
                                    <GridViewColumn Header="Surface" Width="90" DisplayMemberBinding="{Binding Area}"/>
                                    <GridViewColumn Header="Batterie" Width="110" DisplayMemberBinding="{Binding Battery}"/>
                                    <GridViewColumn Header="Fautes" Width="70" DisplayMemberBinding="{Binding Faults}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" Background="Transparent"/>
                        <DockPanel Grid.Row="2">
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Réinitialiser le zoom" Click="ResetHistoryZoom_Click" Style="{StaticResource Secondary}" Margin="0"/>
                                    <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center">
                                        <Run Text="Trajet du nettoyage sélectionné sur la carte "/><Run Text="{Binding HistoryMapName, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="."/>
                                    </TextBlock>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap">
                                    <Run Text="Résultat : "/><Run Text="{Binding HistoryResultText, Mode=OneWay}" FontWeight="SemiBold"/>
                                </TextBlock>
                            </StackPanel>
                            <controls:MapView x:Name="HistoryCanvas" Scene="{Binding HistoryScene}"/>
                        </DockPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Réglages">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                            <TextBlock Text="Réglages de lavage" Style="{StaticResource Section}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding HotWaterMop}" FontWeight="SemiBold" Content="Laver à l'eau chaude"/>
                                    <TextBlock Text="Idéal pour les nettoyages en profondeur, déconseillé pour les parquets ou stratifiés." Style="{StaticResource Muted}" Margin="20,0,0,10"/>
                                    <CheckBox IsChecked="{Binding Detergent}" FontWeight="SemiBold" Content="Laver avec le produit de nettoyage"/>
                                    <TextBlock Text="Votre robot lavera le sol avec le produit de nettoyage dans la station." Style="{StaticResource Muted}" Margin="20,0,0,10"/>
                                    <DockPanel Margin="0,4,0,0">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding SolutionStatus}" Style="{StaticResource Muted}"/>
                                        <TextBlock Text="Produit de nettoyage" FontWeight="SemiBold"/>
                                    </DockPanel>
                                    <TextBlock Text="Indique s'il reste suffisamment de produit dans la station." Style="{StaticResource Muted}" Margin="0,0,0,10"/>
                                    <CheckBox IsChecked="{Binding WashMopBeforeClean}" FontWeight="SemiBold" Content="Prolonger les préparatifs de lavage"/>
                                    <TextBlock Text="Garantit une couverture de nettoyage homogène en consacrant plus de temps à la préparation sur la station d'accueil." Style="{StaticResource Muted}" Margin="20,0,0,0"/>
                                    <TextBlock Text="Le robot ne communique pas encore cet état. Cette case reflète donc le dernier choix fait ici." Style="{StaticResource Muted}" FontSize="11" Margin="20,2,0,0"
                                               Visibility="{Binding WashMopBeforeCleanKnown, Converter={StaticResource Collapse}}"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Réglages station" Style="{StaticResource Section}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Intervalle d'auto-nettoyage" FontWeight="SemiBold"/>
                                    <TextBlock Text="Définissez la fréquence à laquelle votre robot revient nettoyer son rouleau humide ou vider le collecteur pendant le nettoyage." Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding BackWashOptions}" SelectedItem="{Binding BackWash}" Width="260" HorizontalAlignment="Left">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="{Binding BackWash.Description}" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
                                    <CheckBox IsChecked="{Binding HotWaterSwitch}" FontWeight="SemiBold" Content="S'autonettoie à l'eau chaude" Margin="0,0,0,10"/>
                                    <TextBlock Text="Durée de séchage sur rouleau humide" FontWeight="SemiBold"/>
                                    <ComboBox ItemsSource="{Binding DryOptions}" SelectedItem="{Binding DryDuration}" Width="260" HorizontalAlignment="Left">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="{Binding DryDuration.Description}" Style="{StaticResource Muted}"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Réglages vocaux du robot" Style="{StaticResource Section}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding Alarm}" FontWeight="SemiBold" Content="Activer les commandes vocales du robot" Margin="0,0,0,10"/>
                                    <TextBlock Text="Volume" FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Slider Value="{Binding Volume}" Minimum="0" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" Width="200" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Volume}" Margin="10,0,10,0" VerticalAlignment="Center" Width="30"/>
                                        <Button Content="Appliquer" Command="{Binding ApplyVolumeCommand}" Margin="0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Chaque réglage est envoyé au robot immédiatement, comme le fait l'application officielle." Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Journal">
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10">
                            Le journal affiche les événements notables signalés par le robot (fautes, fin de nettoyage, changement de carte…) et le résultat des commandes envoyées depuis cette fenêtre. Il n'enregistre pas chaque message échangé avec le robot : activez la capture ci-dessous pour tout enregistrer dans un fichier, ce qui peut aider à repérer des messages encore non identifiés.
                        </TextBlock>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding CaptureInfo}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <Button Content="{Binding CaptureButtonLabel}" Command="{Binding ToggleCaptureCommand}" Style="{StaticResource Secondary}" Margin="0,0,10,0"/>
                        </DockPanel>
                        <ListBox ItemsSource="{Binding Log}" FontFamily="Consolas" FontSize="12"/>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
