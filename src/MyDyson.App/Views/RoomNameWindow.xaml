<Window x:Class="MyDyson.App.Views.RoomNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Renommer la pièce" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <ResourceDictionary Source="/Themes/Controls.xaml"/>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock x:Name="Intro" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <TextBlock Text="Type de pièce" Style="{StaticResource Label}" Margin="0,0,0,4"/>
        <ComboBox x:Name="TypeBox" SelectionChanged="Type_Changed"/>

        <DockPanel Margin="0,8,0,4">
            <Button DockPanel.Dock="Right" x:Name="ResetNameButton" Content="Nom du type" Click="ResetName_Click" Margin="8,0,0,0"
                    Style="{StaticResource Secondary}" ToolTip="Remet le nom que Dyson donne à ce type de pièce"/>
            <TextBlock Text="Nom affiché" Style="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBox x:Name="NameBox" Padding="6,4" Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}"
                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
        <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap">
            Le type sert aux commandes vocales et prérremplit le nom ; gardez le nom proposé pour que la pièce s'appelle comme dans l'application mobile, ou écrivez le vôtre.
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,-8">
            <Button Content="Annuler" IsCancel="True" Style="{StaticResource Secondary}"/>
            <Button x:Name="OkButton" Content="Renommer" IsDefault="True" Click="Ok_Click" Margin="0"/>
        </StackPanel>
    </StackPanel>
</Window>
