<Window x:Class="MyDyson.App.Views.ScheduleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="520" Height="720" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Through a template rather than ItemStringFormat, which the closed box ignores. -->
            <DataTemplate x:Key="TwoDigits"><TextBlock Text="{Binding StringFormat={}{0:00}}"/></DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="{Binding MapText}" Style="{StaticResource Muted}" Margin="0,0,0,10"/>

        <!-- Start time and days -->
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Heure de début" Style="{StaticResource Label}" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding Hours}" SelectedItem="{Binding Hour}" Width="70"
                          AutomationProperties.Name="Heure" ItemTemplate="{StaticResource TwoDigits}"/>
                <TextBlock Text=":" VerticalAlignment="Center" Margin="6,0,6,4" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding Minutes}" SelectedItem="{Binding Minute}" Width="70"
                          AutomationProperties.Name="Minutes" ItemTemplate="{StaticResource TwoDigits}"/>
            </StackPanel>

            <TextBlock Text="Jours" Style="{StaticResource Label}" Margin="0,8,0,4"/>
            <ItemsControl ItemsSource="{Binding Days}" AutomationProperties.Name="Jours de la semaine">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ToggleButton Content="{Binding Letter}" IsChecked="{Binding IsChecked}" ToolTip="{Binding Name}"
                                      AutomationProperties.Name="{Binding Name}"
                                      Width="40" Height="34" Margin="0,0,6,0" Style="{StaticResource ToolbarToggle}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <DockPanel Margin="0,14,0,4">
                <Button DockPanel.Dock="Right" Content="Tout décocher" Command="{Binding ClearRoomsCommand}"
                        Style="{StaticResource Secondary}" Margin="8,0,0,0" VerticalAlignment="Bottom"/>
                <TextBlock Text="Pièces, dans l'ordre de passage. Cochez-les, puis réglez chacune comme pour un nettoyage lancé à la main."
                           Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0"/>
            </DockPanel>
        </StackPanel>

        <!-- Buttons, with why saving is not possible yet -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,-8">
                <Button Content="Annuler" IsCancel="True" Style="{StaticResource Secondary}" MinWidth="100"/>
                <Button Content="Enregistrer" IsDefault="True" IsEnabled="{Binding CanSave}" Click="Save_Click" Margin="0,0,0,8" MinWidth="100"
                        ToolTipService.ShowOnDisabled="True" ToolTip="{Binding MissingTip}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding Missing}" Style="{StaticResource Muted}"/>
                <TextBlock Text="{Binding EstimateText}" Style="{StaticResource Muted}" FontSize="11"/>
                <TextBlock Text="{Binding OverlapWarning}" Foreground="{DynamicResource DangerBrush}" FontSize="11" TextWrapping="Wrap"
                           Visibility="{Binding OverlapWarning, Converter={StaticResource Show}}"/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rooms}" ItemTemplate="{StaticResource RoomSettingsRow}" AutomationProperties.Name="Pièces de la carte"/>
        </ScrollViewer>
    </DockPanel>
</Window>
