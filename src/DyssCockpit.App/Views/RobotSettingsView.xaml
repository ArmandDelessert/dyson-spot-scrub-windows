<UserControl x:Class="DyssCockpit.App.Views.RobotSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:DyssCockpit.App"
             xmlns:vm="using:DyssCockpit.Presentation.ViewModels">
    <UserControl.Resources>
        <local:PercentConverter x:Key="Percent"/>
        <DataTemplate x:Key="BackWashItem" x:DataType="vm:BackWashOption"><TextBlock Text="{x:Bind Label}"/></DataTemplate>
        <DataTemplate x:Key="DryItem" x:DataType="vm:DryOption"><TextBlock Text="{x:Bind Label}"/></DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="16,0,16,16" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock x:Uid="RobotSettings_EachSettingIsSentTo" Style="{StaticResource Muted}" Margin="0,0,0,12"/>

            <TextBlock x:Uid="RobotSettings_MoppingSettings" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="RobotSettings_MopWithHotWater" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Uid="RobotSettings_BestForDeepCleansNot" Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <ToggleSwitch x:Uid="RobotSettings_MopWithHotWater2" Grid.Column="1" IsOn="{x:Bind ViewModel.HotWaterMop, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"/>
                    </Grid>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="RobotSettings_MopWithCleaningSolution" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Uid="RobotSettings_YourRobotWillMopThe" Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <ToggleSwitch x:Uid="RobotSettings_MopWithCleaningSolution2" Grid.Column="1" IsOn="{x:Bind ViewModel.Detergent, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"/>
                    </Grid>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="RobotSettings_CleaningSolution" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Uid="RobotSettings_ShowsWhetherThereIsEnough" Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SolutionStatus, Mode=OneWay}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="RobotSettings_ExtendTheMoppingPreparation" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Uid="RobotSettings_EnsuresEvenCleaningCoverageBy" Style="{StaticResource Caption}"/>
                            <TextBlock x:Uid="RobotSettings_TheRobotDoesNotReport" Style="{StaticResource Caption}"
                                       Margin="0,2,0,0" Visibility="{x:Bind local:Ui.Unless(ViewModel.WashMopBeforeCleanKnown), Mode=OneWay}"/>
                        </StackPanel>
                        <ToggleSwitch x:Uid="RobotSettings_ExtendTheMoppingPreparation2" Grid.Column="1" IsOn="{x:Bind ViewModel.WashMopBeforeClean, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock x:Uid="RobotSettings_DockSettings" Style="{StaticResource Section}" Margin="0,8,0,8"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="RobotSettings_SelfCleaningInterval" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Uid="RobotSettings_SetHowOftenYourRobot" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{x:Bind ViewModel.BackWash.Description, Mode=OneWay, FallbackValue=''}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                       Visibility="{x:Bind local:Ui.IfAny(ViewModel.BackWash.Description), Mode=OneWay, FallbackValue=Collapsed}"/>
                        </StackPanel>
                        <ComboBox x:Uid="RobotSettings_SelfCleaningInterval2" Grid.Column="1" ItemsSource="{x:Bind ViewModel.BackWashOptions}" SelectedItem="{x:Bind ViewModel.BackWash, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource BackWashItem}" Width="240" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Uid="RobotSettings_SelfCleansWithHotWater" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                        <ToggleSwitch x:Uid="RobotSettings_SelfCleansWithHotWater2" Grid.Column="1" IsOn="{x:Bind ViewModel.HotWaterSwitch, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"/>
                    </Grid>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="RobotSettings_MopRollerDryingTime" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="{x:Bind ViewModel.DryDuration.Description, Mode=OneWay, FallbackValue=''}" Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <ComboBox x:Uid="RobotSettings_DryingTime" Grid.Column="1" ItemsSource="{x:Bind ViewModel.DryOptions}" SelectedItem="{x:Bind ViewModel.DryDuration, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource DryItem}" Width="240" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock x:Uid="RobotSettings_RobotVoiceSettings" Style="{StaticResource Section}" Margin="0,8,0,8"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Uid="RobotSettings_TurnOnTheRobotS" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                        <ToggleSwitch x:Uid="RobotSettings_TurnOnTheRobotS2" Grid.Column="1" IsOn="{x:Bind ViewModel.Alarm, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"/>
                    </Grid>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Uid="RobotSettings_Volume" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                            <Slider x:Uid="RobotSettings_Volume2" Value="{x:Bind VolumeValue, Mode=TwoWay}" Minimum="0" Maximum="100" StepFrequency="10" SnapsTo="StepValues"
                                    TickFrequency="10" Width="200" VerticalAlignment="Center" ThumbToolTipValueConverter="{StaticResource Percent}"/>
                            <Button x:Uid="RobotSettings_Apply" Command="{x:Bind ViewModel.ApplyVolumeCommand}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
