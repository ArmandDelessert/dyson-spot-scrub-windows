<ContentDialog x:Class="DyssCockpit.App.Views.ScheduleEditorDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:local="using:DyssCockpit.App"
               xmlns:vm="using:DyssCockpit.Presentation.ViewModels"
               Title="{x:Bind ViewModel.Title}"
               PrimaryButtonText='{local:Tr Fr="Enregistrer", En="Save"}' CloseButtonText='{local:Tr Fr="Annuler", En="Cancel"}' DefaultButton="Primary"
               IsPrimaryButtonEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}">
    <StackPanel Spacing="12" Width="560">
        <TextBlock Text="{x:Bind ViewModel.MapText}" Style="{StaticResource Muted}"/>

        <!-- Start time and days -->
        <StackPanel Spacing="6">
            <TextBlock Text='{local:Tr Fr="Heure de début", En="Start time"}'/>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <ComboBox x:Name="HourBox" Width="90" SelectedIndex="{x:Bind ViewModel.Hour, Mode=TwoWay}" AutomationProperties.Name='{local:Tr Fr="Heure", En="Hour"}'/>
                <TextBlock Text=":" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ComboBox x:Name="MinuteBox" Width="90" SelectedIndex="{x:Bind ViewModel.Minute, Mode=TwoWay}" AutomationProperties.Name='{local:Tr Fr="Minutes", En="Minutes"}'/>
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text='{local:Tr Fr="Jours", En="Days"}'/>
            <ItemsControl ItemsSource="{x:Bind ViewModel.Days}" IsTabStop="False" AutomationProperties.Name='{local:Tr Fr="Jours de la semaine", En="Days of the week"}'>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DayOption">
                        <ToggleButton Content="{x:Bind Letter}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" Width="44" Height="36"
                                      ToolTipService.ToolTip="{x:Bind Name}" AutomationProperties.Name="{x:Bind Name}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text='{local:Tr Fr="Pièces, dans l&apos;ordre de passage. Cochez-les, puis réglez chacune comme pour un nettoyage lancé à la main.", En="Rooms, in cleaning order. Tick them, then set each one as for a clean started by hand."}'
                       TextWrapping="Wrap" VerticalAlignment="Bottom"/>
            <Button Grid.Column="1" Content='{local:Tr Fr="Tout décocher", En="Untick all"}' Command="{x:Bind ViewModel.ClearRoomsCommand}" VerticalAlignment="Bottom"/>
        </Grid>
        <ItemsControl ItemsSource="{x:Bind ViewModel.Rooms}" ItemTemplate="{StaticResource RoomSettingsRow}" IsTabStop="False"
                      AutomationProperties.Name='{local:Tr Fr="Pièces de la carte", En="Rooms of the map"}'/>

        <!-- Why saving is not possible yet, and what the schedule will take. -->
        <StackPanel Spacing="2">
            <TextBlock Text="{x:Bind ViewModel.Missing, Mode=OneWay}" Style="{StaticResource Muted}"
                       Visibility="{x:Bind local:Ui.IfAny(ViewModel.Missing), Mode=OneWay}"/>
            <TextBlock Text="{x:Bind ViewModel.EstimateText, Mode=OneWay}" Style="{StaticResource Caption}"/>
            <TextBlock Text="{x:Bind ViewModel.OverlapWarning, Mode=OneWay}" Style="{StaticResource Warning}"
                       Visibility="{x:Bind local:Ui.IfAny(ViewModel.OverlapWarning), Mode=OneWay}"/>
        </StackPanel>
    </StackPanel>
</ContentDialog>
