<ContentDialog x:Uid="ScheduleEditorDialog_Save" x:Class="DyssCockpit.App.Views.ScheduleEditorDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:local="using:DyssCockpit.App"
               xmlns:vm="using:DyssCockpit.Presentation.ViewModels"
               Title="{x:Bind ViewModel.Title}" DefaultButton="Primary"
               IsPrimaryButtonEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}">
    <StackPanel Spacing="12" Width="560">
        <TextBlock Text="{x:Bind ViewModel.MapText}" Style="{StaticResource Muted}"/>

        <!-- Start time and days -->
        <StackPanel Spacing="6">
            <TextBlock x:Uid="ScheduleEditorDialog_StartTime"/>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <ComboBox x:Uid="ScheduleEditorDialog_Hour" x:Name="HourBox" Width="90" SelectedIndex="{x:Bind ViewModel.Hour, Mode=TwoWay}"/>
                <TextBlock Text=":" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ComboBox x:Uid="ScheduleEditorDialog_Minutes" x:Name="MinuteBox" Width="90" SelectedIndex="{x:Bind ViewModel.Minute, Mode=TwoWay}"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock x:Uid="ScheduleEditorDialog_Days"/>
            <ItemsControl x:Uid="ScheduleEditorDialog_DaysOfTheWeek" ItemsSource="{x:Bind ViewModel.Days}" IsTabStop="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DayOption">
                        <ToggleButton Content="{x:Bind Letter}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" Width="44" Height="36"
                                      ToolTipService.ToolTip="{x:Bind Name}" AutomationProperties.Name="{x:Bind Name}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <CheckBox x:Uid="ScheduleEditorDialog_RepeatEveryWeek" IsChecked="{x:Bind ViewModel.Repeats, Mode=TwoWay}"/>
            <TextBlock x:Uid="ScheduleEditorDialog_WithoutRepetitionTheRobotRuns"
                       Style="{StaticResource Caption}" TextWrapping="Wrap" Visibility="{x:Bind local:Ui.Unless(ViewModel.Repeats), Mode=OneWay}"/>
        </StackPanel>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="ScheduleEditorDialog_RoomsInCleaningOrderTick"
                       TextWrapping="Wrap" VerticalAlignment="Bottom"/>
            <Button x:Uid="ScheduleEditorDialog_UntickAll" Grid.Column="1" Command="{x:Bind ViewModel.ClearRoomsCommand}" VerticalAlignment="Bottom"/>
        </Grid>
        <ItemsControl x:Uid="ScheduleEditorDialog_RoomsOfTheMap" ItemsSource="{x:Bind ViewModel.Rooms}" ItemTemplate="{StaticResource RoomSettingsRow}" IsTabStop="False"/>

        <!-- Why saving is not possible yet, and what the schedule will take. -->
        <StackPanel Spacing="2">
            <TextBlock Text="{x:Bind ViewModel.Missing, Mode=OneWay}" Style="{StaticResource Muted}"
                       Visibility="{x:Bind local:Ui.IfAny(ViewModel.Missing), Mode=OneWay}"/>
            <TextBlock Text="{x:Bind ViewModel.EstimateText, Mode=OneWay}" Style="{StaticResource Caption}"/>
            <TextBlock Text="{x:Bind ViewModel.OverlapWarning, Mode=OneWay}" Style="{StaticResource Warning}"
                       Visibility="{x:Bind local:Ui.IfAny(ViewModel.OverlapWarning), Mode=OneWay}"/>
        </StackPanel>
    </StackPanel>
</ContentDialog>
