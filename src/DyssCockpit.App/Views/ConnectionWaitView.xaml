<UserControl x:Class="DyssCockpit.App.Views.ConnectionWaitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:DyssCockpit.App">
    <Border Style="{StaticResource Card}" Width="480" Padding="28" Margin="16,48" HorizontalAlignment="Center" VerticalAlignment="Top">
        <StackPanel Spacing="12">
            <TextBlock x:Uid="ConnectionWait_CannotReachTheDysonCloud" Style="{StaticResource SubtitleTextBlockStyle}"/>
            <TextBlock x:Name="Reason" Style="{StaticResource Muted}"/>
            <TextBlock x:Uid="ConnectionWait_TheNetworkMayNotBe" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <ProgressRing IsActive="True" Width="16" Height="16"/>
                <TextBlock x:Name="Countdown" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                <Button x:Uid="ConnectionWait_Quit" Click="Quit_Click" MinWidth="100"/>
                <Button x:Uid="ConnectionWait_TryAgainNow" Click="Retry_Click" Style="{StaticResource AccentButtonStyle}" MinWidth="100"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
