<UserControl x:Class="DyssCockpit.App.Views.JournalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:DyssCockpit.App">
    <Grid Padding="16,0,16,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource Muted}" MaxWidth="900" HorizontalAlignment="Left"
                   Text='{local:Tr Fr="Le journal affiche les événements notables signalés par le robot (fautes, fin de nettoyage, changement de carte…) et le résultat des commandes envoyées depuis cette fenêtre. Il ne montre pas chaque message échangé avec le robot : activez l&apos;enregistrement ci-dessous pour tous les garder, un fichier par jour, gardé 30 jours. Cela aide à repérer des messages encore non identifiés.", En="The log shows the notable events the robot reports (faults, end of a clean, change of map…) and the result of the commands sent from this window. It does not show every message exchanged with the robot: turn on recording below to keep them all, one file per day, kept 30 days. This helps spot messages not yet identified."}'/>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0" Padding="16,8">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text='{local:Tr Fr="Enregistrer tous les messages", En="Record all messages"}' Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <TextBlock Text="{x:Bind ViewModel.RecordInfo, Mode=OneWay}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </StackPanel>
                <Button Grid.Column="1" Content='{local:Tr Fr="Ouvrir le dossier", En="Open the folder"}' Command="{x:Bind ViewModel.OpenRecordFolderCommand}" VerticalAlignment="Center"
                        ToolTipService.ToolTip="{x:Bind ViewModel.RecordFolder}"/>
                <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.RecordMessages, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                              VerticalAlignment="Center" AutomationProperties.Name='{local:Tr Fr="Enregistrer tous les messages", En="Record all messages"}'/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0" Padding="0,8">
            <ListView ItemsSource="{x:Bind ViewModel.Log}" SelectionMode="None" AutomationProperties.Name='{local:Tr Fr="Journal", En="Log"}'>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{x:Bind}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</UserControl>
