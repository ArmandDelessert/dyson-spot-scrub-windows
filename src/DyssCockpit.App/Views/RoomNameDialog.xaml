<ContentDialog x:Uid="RoomNameDialog_RenameTheRoom" x:Class="DyssCockpit.App.Views.RoomNameDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:DyssCockpit.App" DefaultButton="Primary">
    <StackPanel Spacing="12" MinWidth="380">
        <TextBlock x:Name="Intro" TextWrapping="Wrap"/>
        <ComboBox x:Uid="RoomNameDialog_RoomType" x:Name="TypeBox" HorizontalAlignment="Stretch" SelectionChanged="Type_Changed"/>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Uid="RoomNameDialog_DisplayedName" x:Name="NameBox"/>
            <Button x:Uid="RoomNameDialog_TypeSName" x:Name="ResetNameButton" Grid.Column="1" Click="ResetName_Click" VerticalAlignment="Bottom"/>
        </Grid>
        <TextBlock x:Uid="RoomNameDialog_TheTypeIsUsedBy" Style="{StaticResource Caption}"/>
    </StackPanel>
</ContentDialog>
