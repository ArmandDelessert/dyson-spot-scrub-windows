<Window x:Class="DyssCockpit.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DySS Cockpit">
    <Window.SystemBackdrop>
        <MicaBackdrop/>
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <!-- The window's own title bar, in the app's colours: the pane button of the dashboard's
             navigation, and a back button while the map manager is open. -->
        <TitleBar x:Name="AppTitleBar" Title="DySS Cockpit" IsBackButtonVisible="False" IsPaneToggleButtonVisible="False">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.ico"/>
            </TitleBar.IconSource>
        </TitleBar>
        <!-- One window throughout: the login, the wait for the network, then the dashboard. -->
        <ContentControl x:Name="Host" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False"/>
    </Grid>
</Window>
