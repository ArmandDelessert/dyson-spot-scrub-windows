<ResourceDictionary x:Class="DyssCockpit.App.Views.Templates"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:DyssCockpit.App"
                    xmlns:vm="using:DyssCockpit.Presentation.ViewModels">

    <!-- The choices offered for a room or a drawn zone, by their labels. -->
    <DataTemplate x:Key="CleanTypeItem" x:DataType="vm:CleanTypeOption"><TextBlock Text="{x:Bind Label}"/></DataTemplate>
    <DataTemplate x:Key="StrategyItem" x:DataType="vm:StrategyOption"><TextBlock Text="{x:Bind Label}"/></DataTemplate>
    <DataTemplate x:Key="WaterLevelItem" x:DataType="vm:WaterLevelOption"><TextBlock Text="{x:Bind Label}"/></DataTemplate>
    <DataTemplate x:Key="MopPassesItem" x:DataType="vm:MopPassesOption"><TextBlock Text="{x:Bind Label}"/></DataTemplate>
    <DataTemplate x:Key="MapItemName" x:DataType="vm:MapItem"><TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/></DataTemplate>

    <!--
        A room in the clean panel and in the schedule editor: ticked in the order of passage, its
        number beside it, and its four settings folded under a chevron. Ticking a room unfolds them;
        the summary line says what they are while folded.
    -->
    <DataTemplate x:Key="RoomSettingsRow" x:DataType="vm:ZoneItem">
        <Grid Padding="0,4,0,8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{x:Bind OrderText, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            <CheckBox Grid.Column="1" IsChecked="{x:Bind Selected, Mode=TwoWay}" MinWidth="0">
                <TextBlock TextTrimming="CharacterEllipsis">
                    <Run Text="{x:Bind DisplayName}"/>
                    <Run Text="{x:Bind local:Ui.Area(Area)}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </TextBlock>
            </CheckBox>
            <Button Grid.Column="2" Click="Expand_Click" Padding="8,6" VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0"
                    AutomationProperties.Name="{x:Bind local:Ui.SettingsOf(DisplayName)}">
                <FontIcon Glyph="{x:Bind local:Ui.Chevron(IsExpanded), Mode=OneWay}" FontSize="12"/>
            </Button>

            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2">
                <TextBlock Text="{x:Bind Summary, Mode=OneWay}" Style="{StaticResource Caption}"
                           Visibility="{x:Bind local:Ui.Unless(IsExpanded), Mode=OneWay}"/>
                <StackPanel Visibility="{x:Bind IsExpanded, Mode=OneWay}" Spacing="6" Margin="0,4,0,0">
                    <ComboBox ItemsSource="{x:Bind vm:ZoneItem.CleanTypeOptions}" SelectedItem="{x:Bind SelectedCleanType, Mode=TwoWay}"
                              ItemTemplate="{StaticResource CleanTypeItem}" HorizontalAlignment="Stretch"
                              AutomationProperties.Name='{local:Tr Fr="Type de nettoyage", En="Cleaning type"}'/>
                    <ComboBox ItemsSource="{x:Bind vm:ZoneItem.StrategyOptions}" SelectedItem="{x:Bind SelectedStrategy, Mode=TwoWay}"
                              ItemTemplate="{StaticResource StrategyItem}" HorizontalAlignment="Stretch"
                              Visibility="{x:Bind HasVacuum, Mode=OneWay}" AutomationProperties.Name='{local:Tr Fr="Mode d&apos;aspiration", En="Suction mode"}'/>
                    <Grid ColumnSpacing="8" Visibility="{x:Bind HasMop, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{x:Bind vm:ZoneItem.WaterLevelOptions}" SelectedItem="{x:Bind SelectedWaterLevel, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource WaterLevelItem}" HorizontalAlignment="Stretch"
                                  AutomationProperties.Name='{local:Tr Fr="Niveau d&apos;hydratation", En="Water level"}'/>
                        <ComboBox Grid.Column="1" ItemsSource="{x:Bind vm:ZoneItem.MopPassesOptions}" SelectedItem="{x:Bind SelectedMopPasses, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource MopPassesItem}" HorizontalAlignment="Stretch"
                                  AutomationProperties.Name='{local:Tr Fr="Répétitions de lavage", En="Mopping passes"}'/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
