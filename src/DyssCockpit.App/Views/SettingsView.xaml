<UserControl x:Class="DyssCockpit.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:DyssCockpit.App">
    <!-- The application's own settings, in the order of HusqA Cockpit's page: notifications,
         behavior, language, then the map's, then about. The robot's settings are another page. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="16,0,16,16" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock x:Uid="Settings_TheseSettingsAreAboutThis"
                       Style="{StaticResource Muted}" Margin="0,0,0,12"/>

            <!-- Notifications -->
            <TextBlock x:Uid="Settings_Notifications" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="Settings_CleaningStartAndEndNotifications" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"/>
                            <TextBlock x:Uid="Settings_TheEndIncludesTheRobot" Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <ComboBox x:Uid="Settings_CleaningStartAndEndNotifications2" Grid.Column="1" SelectedIndex="{x:Bind ViewModel.TaskNotificationsIndex, Mode=TwoWay}" Width="260" VerticalAlignment="Center">
                            <ComboBoxItem x:Uid="Settings_None"/>
                            <ComboBoxItem x:Uid="Settings_CleaningEndOnly"/>
                            <ComboBoxItem x:Uid="Settings_CleaningStartAndEnd"/>
                        </ComboBox>
                    </Grid>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="Settings_RobotFault" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Uid="Settings_WhenTheRobotReportsA" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch x:Uid="Settings_RobotFault2" Grid.Column="1" IsOn="{x:Bind ViewModel.NotifyRobotFault, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"/>
                    </Grid>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="Settings_UnreachableArea" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Uid="Settings_WhenTheRobotCouldNot" Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <ToggleSwitch x:Uid="Settings_UnreachableArea2" Grid.Column="1" IsOn="{x:Bind ViewModel.NotifyUnreachable, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"/>
                    </Grid>
                    <Button x:Uid="Settings_SendATestNotification" Command="{x:Bind ViewModel.SendTestNotificationCommand}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Behavior -->
            <TextBlock x:Uid="Settings_Behavior" Style="{StaticResource Section}" Margin="0,8,0,8"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="Settings_KeepRunningInTheNotification" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"/>
                            <TextBlock x:Uid="Settings_TheRobotIsStillFollowed" Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <ToggleSwitch x:Uid="Settings_KeepRunningInTheNotification2" Grid.Column="1" IsOn="{x:Bind ViewModel.CloseToTray, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"/>
                    </Grid>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Uid="Settings_StartWithWindowsInThe" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <ToggleSwitch x:Uid="Settings_StartWithWindowsInThe2" Grid.Column="1" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Language -->
            <TextBlock x:Uid="Settings_Language" Style="{StaticResource Section}" Margin="0,8,0,8"/>
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Uid="Settings_DisplayLanguage" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                        <!-- Each language under its own name, so it can be found whatever the current one. -->
                        <ComboBox x:Uid="Settings_DisplayLanguage2" Grid.Column="1" SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}" Width="320" VerticalAlignment="Center">
                            <ComboBoxItem x:Uid="Settings_AutomaticWindowsLanguage"/>
                            <ComboBoxItem Content="Français"/>
                            <ComboBoxItem Content="English"/>
                            <ComboBoxItem Content="Deutsch"/>
                            <ComboBoxItem Content="Español"/>
                            <ComboBoxItem Content="Italiano"/>
                            <ComboBoxItem Content="Nederlands"/>
                            <ComboBoxItem Content="Polski"/>
                            <ComboBoxItem Content="Português (Brasil)"/>
                            <ComboBoxItem Content="Română"/>
                            <ComboBoxItem Content="Türkçe"/>
                            <ComboBoxItem Content="Українська"/>
                            <ComboBoxItem Content="日本語"/>
                            <ComboBoxItem Content="한국어"/>
                            <ComboBoxItem Content="简体中文"/>
                        </ComboBox>
                    </Grid>
                    <InfoBar x:Uid="Settings_RestartRequired" IsClosable="False" IsOpen="{x:Bind ViewModel.IsRestartRequired, Mode=OneWay}" Severity="Informational">
                        <InfoBar.ActionButton>
                            <Button x:Uid="Settings_RestartNow" Command="{x:Bind ViewModel.RestartCommand}"/>
                        </InfoBar.ActionButton>
                    </InfoBar>
                </StackPanel>
            </Border>

            <!-- Map -->
            <TextBlock x:Uid="Settings_Map" Style="{StaticResource Section}" Margin="0,8,0,8"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Uid="Settings_ShowFurniture" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                        <ToggleSwitch x:Uid="Settings_ShowFurniture2" Grid.Column="1" IsOn="{x:Bind ViewModel.ShowFurniture, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"/>
                    </Grid>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="Settings_ShowTravelWithoutCleaning" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Uid="Settings_AddsToThePathThe" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch x:Uid="Settings_ShowTravelWithoutCleaning2" Grid.Column="1" IsOn="{x:Bind ViewModel.ShowTravelPath, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"/>
                    </Grid>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="Settings_ShowTheCleanedArea" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Uid="Settings_WidensThePathToThe" Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <ToggleSwitch x:Uid="Settings_ShowTheCleanedArea2" Grid.Column="1" IsOn="{x:Bind ViewModel.ShowCleanedArea, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"/>
                    </Grid>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="Settings_SmoothTheRobotSMovements" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Uid="Settings_TheRobotGlidesFromOne" Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <ToggleSwitch x:Uid="Settings_SmoothTheRobotSMovements2" Grid.Column="1" IsOn="{x:Bind ViewModel.SmoothRobotMotion, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"/>
                    </Grid>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Uid="Settings_ShowThePNGExportButton" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                        <ToggleSwitch x:Uid="Settings_ShowThePNGExportButton2" Grid.Column="1" IsOn="{x:Bind ViewModel.ShowExportButton, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"/>
                    </Grid>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="Settings_ShowTheCoordinatesAboveThe" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Uid="Settings_ThePointerSPositionOn" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch x:Uid="Settings_ShowTheCoordinatesAboveThe2" Grid.Column="1" IsOn="{x:Bind ViewModel.ShowPointerCoordinates, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"/>
                    </Grid>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="Settings_ShowTheSizeOfDrawn" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Uid="Settings_TheCoordinatesOfEachCorner" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch x:Uid="Settings_ShowTheSizeOfDrawn2" Grid.Column="1" IsOn="{x:Bind ViewModel.ShowShapeDimensions, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"/>
                    </Grid>
                    <TextBlock x:Uid="Settings_TheseSettingsOnlyAffectThis"
                               Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Logs: the application's own, and the recording of the robot's messages -->
            <TextBlock x:Uid="Settings_Logs" Style="{StaticResource Section}" Margin="0,8,0,8"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="Settings_KeepTheApplicationLogs" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Uid="Settings_OneFileADayIn" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                            <HyperlinkButton x:Uid="Settings_OpenTheLogsFolder" Command="{x:Bind ViewModel.OpenLogsFolderCommand}" Padding="0" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ComboBox x:Uid="Settings_Retention" Grid.Column="1" SelectedIndex="{x:Bind ViewModel.LogRetentionIndex, Mode=TwoWay}" Width="220" VerticalAlignment="Center">
                            <ComboBoxItem x:Uid="Settings_1Day"/>
                            <ComboBoxItem x:Uid="Settings_3Days"/>
                            <ComboBoxItem x:Uid="Settings_7Days"/>
                            <ComboBoxItem x:Uid="Settings_14Days"/>
                            <ComboBoxItem x:Uid="Settings_30Days"/>
                            <ComboBoxItem x:Uid="Settings_90Days"/>
                            <ComboBoxItem x:Uid="Settings_KeepForever"/>
                        </ComboBox>                    </Grid>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="Settings_RecordAllMessages" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Uid="Settings_KeepsEveryMessageExchangedWith" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                            <HyperlinkButton x:Uid="Settings_OpenTheMessagesFolder" Command="{x:Bind ViewModel.OpenMessagesFolderCommand}" Padding="0" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ToggleSwitch x:Uid="Settings_RecordAllMessages2" Grid.Column="1" IsOn="{x:Bind ViewModel.RecordMessages, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"/>
                    </Grid>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="Settings_KeepTheRecordedMessages" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Uid="Settings_OlderRecordsAreDeletedWhether" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ComboBox x:Uid="Settings_Retention" Grid.Column="1" SelectedIndex="{x:Bind ViewModel.MessageRetentionIndex, Mode=TwoWay}" Width="220" VerticalAlignment="Center">
                            <ComboBoxItem x:Uid="Settings_1Day"/>
                            <ComboBoxItem x:Uid="Settings_3Days"/>
                            <ComboBoxItem x:Uid="Settings_7Days"/>
                            <ComboBoxItem x:Uid="Settings_14Days"/>
                            <ComboBoxItem x:Uid="Settings_30Days"/>
                            <ComboBoxItem x:Uid="Settings_90Days"/>
                            <ComboBoxItem x:Uid="Settings_KeepForever"/>
                        </ComboBox>                    </Grid>
                </StackPanel>
            </Border>
            <!-- Cleaning history kept on this computer -->
            <TextBlock x:Uid="Settings_CleaningHistory" Style="{StaticResource Section}" Margin="0,8,0,8"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="Settings_KeepTheCleansOnThis" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Uid="Settings_TheDysonCloudOnlyKeeps" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                            <HyperlinkButton x:Uid="Settings_OpenTheCleansFolder" Command="{x:Bind ViewModel.OpenCleansFolderCommand}" Padding="0" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ToggleSwitch x:Uid="Settings_KeepTheCleansOnThis2" Grid.Column="1" IsOn="{x:Bind ViewModel.ArchiveCleans, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"/>
                    </Grid>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="Settings_Retention2" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Uid="Settings_OlderCleansAreDeletedFrom" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ComboBox x:Uid="Settings_Retention" Grid.Column="1" SelectedIndex="{x:Bind ViewModel.CleanArchiveRetentionIndex, Mode=TwoWay}" Width="220" VerticalAlignment="Center">
                            <ComboBoxItem x:Uid="Settings_1Month"/>
                            <ComboBoxItem x:Uid="Settings_3Months"/>
                            <ComboBoxItem x:Uid="Settings_6Months"/>
                            <ComboBoxItem x:Uid="Settings_1Year"/>
                            <ComboBoxItem x:Uid="Settings_2Years"/>
                            <ComboBoxItem x:Uid="Settings_KeepForever"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Account -->
            <TextBlock x:Uid="Settings_Account" Style="{StaticResource Section}" Margin="0,8,0,8"/>
            <Border Style="{StaticResource Card}">
                <Grid Style="{StaticResource Setting}">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Uid="Settings_MyDysonAccount" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="{x:Bind ViewModel.AccountText}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button x:Uid="Settings_LogOut" Grid.Column="1" Command="{x:Bind ViewModel.LogoutCommand}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- About -->
            <TextBlock x:Uid="Settings_About" Style="{StaticResource Section}" Margin="0,8,0,8"/>
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.VersionText}" Style="{StaticResource BodyStrongTextBlockStyle}" IsTextSelectionEnabled="True"/>
                    <TextBlock x:Uid="Settings_IndependentProjectNotAffiliatedWith"
                               Style="{StaticResource Caption}"/>
                    <HyperlinkButton x:Uid="Settings_SourceCode" NavigateUri="https://github.com/ArmandDelessert/dyson-spot-scrub-windows" Padding="0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
