<UserControl x:Class="DyssCockpit.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:DyssCockpit.App">
    <!-- The application's own settings, in the order of HusqA Cockpit's page: notifications,
         behavior, language, then the map's, then about. The robot's settings are another page. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="16,0,16,16" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text='{local:Tr Fr="Ces paramètres concernent cette application, sur cet ordinateur : rien n&apos;est envoyé au robot.", En="These settings are about this application, on this computer: nothing is sent to the robot."}'
                       Style="{StaticResource Muted}" Margin="0,0,0,12"/>

            <!-- Notifications -->
            <TextBlock Text='{local:Tr Fr="Notifications", En="Notifications"}' Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text='{local:Tr Fr="Notifications de début et de fin de nettoyage", En="Cleaning start and end notifications"}' Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"/>
                            <TextBlock Text='{local:Tr Fr="La fin comprend le cas où le robot abandonne son nettoyage.", En="The end includes the robot giving up its clean."}' Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedIndex="{x:Bind ViewModel.TaskNotificationsIndex, Mode=TwoWay}" Width="260" VerticalAlignment="Center"
                                  AutomationProperties.Name='{local:Tr Fr="Notifications de début et de fin de nettoyage", En="Cleaning start and end notifications"}'>
                            <ComboBoxItem Content='{local:Tr Fr="Aucune", En="None"}'/>
                            <ComboBoxItem Content='{local:Tr Fr="Fin de nettoyage seulement", En="Cleaning end only"}'/>
                            <ComboBoxItem Content='{local:Tr Fr="Début et fin de nettoyage", En="Cleaning start and end"}'/>
                        </ComboBox>
                    </Grid>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text='{local:Tr Fr="Zone inaccessible", En="Unreachable area"}' Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text='{local:Tr Fr="Quand le robot n&apos;a pas pu atteindre une pièce sélectionnée.", En="When the robot could not reach a selected room."}' Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.NotifyUnreachable, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                                      AutomationProperties.Name='{local:Tr Fr="Zone inaccessible", En="Unreachable area"}'/>
                    </Grid>
                    <Button Content='{local:Tr Fr="Envoyer une notification de test", En="Send a test notification"}' Command="{x:Bind ViewModel.SendTestNotificationCommand}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Behavior -->
            <TextBlock Text='{local:Tr Fr="Comportement", En="Behavior"}' Style="{StaticResource Section}" Margin="0,8,0,8"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text='{local:Tr Fr="Rester actif dans la zone de notification quand la fenêtre est fermée", En="Keep running in the notification area when the window is closed"}' Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"/>
                            <TextBlock Text='{local:Tr Fr="Le robot reste suivi et les notifications continuent d&apos;arriver. On quitte l&apos;application par le bouton « Quitter » ou le menu de son icône.", En="The robot is still followed and notifications keep coming. Quit the application with the “Quit” button or from its icon&apos;s menu."}' Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.CloseToTray, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                                      AutomationProperties.Name='{local:Tr Fr="Rester actif dans la zone de notification quand la fenêtre est fermée", En="Keep running in the notification area when the window is closed"}'/>
                    </Grid>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text='{local:Tr Fr="Démarrer avec Windows (dans la zone de notification)", En="Start with Windows (in the notification area)"}' Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                                      AutomationProperties.Name='{local:Tr Fr="Démarrer avec Windows (dans la zone de notification)", En="Start with Windows (in the notification area)"}'/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Language -->
            <TextBlock Text='{local:Tr Fr="Langue", En="Language"}' Style="{StaticResource Section}" Margin="0,8,0,8"/>
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text='{local:Tr Fr="Langue d&apos;affichage", En="Display language"}' Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                        <!-- Each language under its own name, so it can be found whatever the current one. -->
                        <ComboBox Grid.Column="1" SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}" Width="320" VerticalAlignment="Center"
                                  AutomationProperties.Name='{local:Tr Fr="Langue d&apos;affichage", En="Display language"}'>
                            <ComboBoxItem Content='{local:Tr Fr="Automatique (langue de Windows)", En="Automatic (Windows language)"}'/>
                            <ComboBoxItem Content="Français"/>
                            <ComboBoxItem Content="English"/>
                        </ComboBox>
                    </Grid>
                    <InfoBar IsClosable="False" IsOpen="{x:Bind ViewModel.IsRestartRequired, Mode=OneWay}" Severity="Informational"
                             Title='{local:Tr Fr="Redémarrage nécessaire", En="Restart required"}'
                             Message='{local:Tr Fr="DySS Cockpit doit redémarrer pour appliquer la nouvelle langue.", En="DySS Cockpit must restart to apply the new language."}'>
                        <InfoBar.ActionButton>
                            <Button Content='{local:Tr Fr="Redémarrer maintenant", En="Restart now"}' Command="{x:Bind ViewModel.RestartCommand}"/>
                        </InfoBar.ActionButton>
                    </InfoBar>
                </StackPanel>
            </Border>

            <!-- Map -->
            <TextBlock Text='{local:Tr Fr="Carte", En="Map"}' Style="{StaticResource Section}" Margin="0,8,0,8"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text='{local:Tr Fr="Afficher les meubles", En="Show furniture"}' Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.ShowFurniture, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                                      AutomationProperties.Name='{local:Tr Fr="Afficher les meubles", En="Show furniture"}'/>
                    </Grid>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text='{local:Tr Fr="Afficher les déplacements sans nettoyage", En="Show travel without cleaning"}' Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text='{local:Tr Fr="Ajoute au trajet les parcours où le robot se déplace sans nettoyer, par exemple pour se repositionner.", En="Adds to the path the stretches where the robot moves without cleaning, for instance to reposition itself."}' Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.ShowTravelPath, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                                      AutomationProperties.Name='{local:Tr Fr="Afficher les déplacements sans nettoyage", En="Show travel without cleaning"}'/>
                    </Grid>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text='{local:Tr Fr="Afficher la surface nettoyée", En="Show the cleaned area"}' Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text='{local:Tr Fr="Élargit le trajet à la largeur du robot, là où il a nettoyé.", En="Widens the path to the robot&apos;s width where it cleaned."}' Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.ShowCleanedArea, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                                      AutomationProperties.Name='{local:Tr Fr="Afficher la surface nettoyée", En="Show the cleaned area"}'/>
                    </Grid>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text='{local:Tr Fr="Afficher le bouton d&apos;export PNG", En="Show the PNG export button"}' Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.ShowExportButton, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                                      AutomationProperties.Name='{local:Tr Fr="Afficher le bouton d&apos;export PNG", En="Show the PNG export button"}'/>
                    </Grid>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text='{local:Tr Fr="Lisser les déplacements du robot", En="Smooth the robot&apos;s movements"}' Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text='{local:Tr Fr="Le robot glisse d&apos;une position à la suivante au lieu de sauter, avec un léger retard.", En="The robot glides from one position to the next instead of jumping, with a slight delay."}' Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.SmoothRobotMotion, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                                      AutomationProperties.Name='{local:Tr Fr="Lisser les déplacements du robot", En="Smooth the robot&apos;s movements"}'/>
                    </Grid>
                    <TextBlock Text='{local:Tr Fr="Ces réglages ne concernent que cet affichage : rien n&apos;est envoyé au robot.", En="These settings only affect this display: nothing is sent to the robot."}'
                               Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- File retention -->
            <TextBlock Text='{local:Tr Fr="Conservation des fichiers", En="File retention"}' Style="{StaticResource Section}" Margin="0,8,0,8"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text='{local:Tr Fr="Journaux de l&apos;application", En="Application logs"}' Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text='{local:Tr Fr="Un fichier par jour, dans le dossier Logs. Les plus anciens sont supprimés.", En="One file a day, in the Logs folder. The oldest are deleted."}' Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedIndex="{x:Bind ViewModel.LogRetentionIndex, Mode=TwoWay}" Width="220" VerticalAlignment="Center"
                                  AutomationProperties.Name='{local:Tr Fr="Durée de conservation", En="Retention"}'>
                            <ComboBoxItem Content='{local:Tr Fr="1 jour", En="1 day"}'/>
                            <ComboBoxItem Content='{local:Tr Fr="3 jours", En="3 days"}'/>
                            <ComboBoxItem Content='{local:Tr Fr="7 jours", En="7 days"}'/>
                            <ComboBoxItem Content='{local:Tr Fr="14 jours", En="14 days"}'/>
                            <ComboBoxItem Content='{local:Tr Fr="30 jours", En="30 days"}'/>
                            <ComboBoxItem Content='{local:Tr Fr="90 jours", En="90 days"}'/>
                            <ComboBoxItem Content='{local:Tr Fr="Toujours conserver", En="Keep forever"}'/>
                        </ComboBox>                    </Grid>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text='{local:Tr Fr="Messages du robot enregistrés", En="Recorded robot messages"}' Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text='{local:Tr Fr="Ce que l&apos;onglet Journal enregistre quand on le demande, dans le dossier Messages. Un fichier par jour.", En="What the Log tab records when asked to, in the Messages folder. One file a day."}' Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedIndex="{x:Bind ViewModel.MessageRetentionIndex, Mode=TwoWay}" Width="220" VerticalAlignment="Center"
                                  AutomationProperties.Name='{local:Tr Fr="Durée de conservation", En="Retention"}'>
                            <ComboBoxItem Content='{local:Tr Fr="1 jour", En="1 day"}'/>
                            <ComboBoxItem Content='{local:Tr Fr="3 jours", En="3 days"}'/>
                            <ComboBoxItem Content='{local:Tr Fr="7 jours", En="7 days"}'/>
                            <ComboBoxItem Content='{local:Tr Fr="14 jours", En="14 days"}'/>
                            <ComboBoxItem Content='{local:Tr Fr="30 jours", En="30 days"}'/>
                            <ComboBoxItem Content='{local:Tr Fr="90 jours", En="90 days"}'/>
                            <ComboBoxItem Content='{local:Tr Fr="Toujours conserver", En="Keep forever"}'/>
                        </ComboBox>                    </Grid>
                </StackPanel>
            </Border>
            <!-- Account -->
            <TextBlock Text='{local:Tr Fr="Compte", En="Account"}' Style="{StaticResource Section}" Margin="0,8,0,8"/>
            <Border Style="{StaticResource Card}">
                <Grid Style="{StaticResource Setting}">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text='{local:Tr Fr="Compte MyDyson", En="MyDyson account"}' Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="{x:Bind ViewModel.AccountText}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content='{local:Tr Fr="Se déconnecter", En="Log out"}' Command="{x:Bind ViewModel.LogoutCommand}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- About -->
            <TextBlock Text='{local:Tr Fr="À propos", En="About"}' Style="{StaticResource Section}" Margin="0,8,0,8"/>
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.VersionText}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <TextBlock Text='{local:Tr Fr="Projet indépendant, non affilié à Dyson, ni approuvé ou soutenu par Dyson. Dyson, Spot+Scrub et MyDyson sont des marques du groupe Dyson.", En="Independent project, not affiliated with, approved or supported by Dyson. Dyson, Spot+Scrub and MyDyson are trademarks of the Dyson group."}'
                               Style="{StaticResource Caption}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <HyperlinkButton Content='{local:Tr Fr="Code source", En="Source code"}' NavigateUri="https://github.com/ArmandDelessert/dyson-spot-scrub-windows" Padding="0"/>
                        <HyperlinkButton Content='{local:Tr Fr="Ouvrir le dossier des journaux", En="Open the logs folder"}' Command="{x:Bind ViewModel.OpenLogsFolderCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
