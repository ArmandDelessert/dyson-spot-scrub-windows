<UserControl x:Class="DyssCockpit.App.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:DyssCockpit.App">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}" Width="460" Padding="28" Margin="16,48" HorizontalAlignment="Center" VerticalAlignment="Top">
            <StackPanel Spacing="12">
                <TextBlock x:Uid="Login_LogInToTheMyDyson" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <TextBlock x:Uid="Login_ForTheDysonSpotScrub" Style="{StaticResource Muted}"/>

                <!-- An address, not prose: no spell checking, no word suggestions. -->
                <TextBox x:Uid="Login_EMail" InputScope="EmailSmtpAddress" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                         Text="{x:Bind ViewModel.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{x:Bind ViewModel.CanEditAccount, Mode=OneWay}"/>
                <!-- Where the account was created: Dyson keeps accounts per country. -->
                <ComboBox x:Uid="Login_AccountCountry" ItemsSource="{x:Bind ViewModel.Countries}" SelectedItem="{x:Bind ViewModel.SelectedCountry, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" IsEnabled="{x:Bind ViewModel.CanEditAccount, Mode=OneWay}"/>
                <ComboBox x:Uid="Login_Language" ItemsSource="{x:Bind ViewModel.Cultures}" SelectedItem="{x:Bind ViewModel.SelectedCulture, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" IsEnabled="{x:Bind ViewModel.CanEditAccount, Mode=OneWay}"/>

                <Button x:Uid="Login_SendTheCode" Command="{x:Bind ViewModel.SendCodeCommand}" Style="{StaticResource AccentButtonStyle}"
                        Visibility="{x:Bind ViewModel.CanEditAccount, Mode=OneWay}"/>

                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.CodeSent, Mode=OneWay}">
                    <PasswordBox x:Uid="Login_Password" x:Name="Password"/>
                    <TextBox x:Uid="Login_CodeReceivedByEMail" InputScope="Number" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                             Text="{x:Bind ViewModel.OtpCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="Login_LogIn" Click="Verify_Click" Style="{StaticResource AccentButtonStyle}"
                                IsEnabled="{x:Bind local:Ui.Not(ViewModel.Busy), Mode=OneWay}"/>
                        <Button x:Uid="Login_StartAgain" Command="{x:Bind ViewModel.RestartCommand}"/>
                    </StackPanel>
                </StackPanel>

                <InfoBar Severity="{x:Bind local:Ui.Severity(ViewModel.MessageIsError), Mode=OneWay}" IsClosable="False"
                         Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                         IsOpen="{x:Bind local:Ui.HasText(ViewModel.Message), Mode=OneWay}"/>
                <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.Busy, Mode=OneWay}"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
