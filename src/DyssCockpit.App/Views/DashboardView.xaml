<UserControl x:Class="DyssCockpit.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:DyssCockpit.App"
             xmlns:controls="using:DyssCockpit.App.Controls"
             xmlns:vm="using:DyssCockpit.Presentation.ViewModels">
    <Grid Padding="16,0,16,16" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="370"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Left column: the robot, the clean, the dock, the consumables. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="0,0,14,0">

                <!-- State -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.Status.StateText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <TextBlock Text="{x:Bind ViewModel.Status.ActionText, Mode=OneWay}" Style="{StaticResource Muted}"
                                   Visibility="{x:Bind local:Ui.IfAny(ViewModel.Status.ActionText), Mode=OneWay}"/>
                        <TextBlock x:Uid="Dashboard_GoingBackToTheDock" Style="{StaticResource Muted}"
                                   Visibility="{x:Bind ViewModel.Status.ReturningToWash, Mode=OneWay}"/>
                        <TextBlock Text="{x:Bind ViewModel.Status.DockText, Mode=OneWay}" Style="{StaticResource Muted}"
                                   Visibility="{x:Bind ViewModel.Status.DockBusy, Mode=OneWay}"/>
                        <TextBlock Text="{x:Bind ViewModel.Status.FaultText, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   Visibility="{x:Bind ViewModel.Status.HasRealFault, Mode=OneWay}"/>
                        <Grid Margin="0,10,0,0">
                            <TextBlock x:Uid="Dashboard_Battery" Style="{StaticResource Muted}"/>
                            <TextBlock Text="{x:Bind local:Ui.Percent(ViewModel.Status.Battery), Mode=OneWay}" HorizontalAlignment="Right"/>
                        </Grid>
                        <ProgressBar x:Uid="Dashboard_Battery2" Value="{x:Bind local:Ui.Number(ViewModel.Status.Battery), Mode=OneWay}" Maximum="100" Margin="0,4,0,0"
                                     Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                            <Button Command="{x:Bind ViewModel.Status.PauseResumeCommand}" IsEnabled="{x:Bind ViewModel.Status.CanPause, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="{x:Bind local:Ui.PauseGlyph(ViewModel.Status.Paused), Mode=OneWay}" FontSize="14"/>
                                    <TextBlock Text="{x:Bind ViewModel.Status.PauseResumeLabel, Mode=OneWay}"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.Status.AbortCommand}" IsEnabled="{x:Bind ViewModel.Status.CanAbort, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE80F;" FontSize="14"/>
                                    <TextBlock x:Uid="Dashboard_ReturnToDock"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Clean -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="Dashboard_Cleaning" Style="{StaticResource Section}" Margin="0"/>
                        <!-- The picker gets the full width; its two actions sit underneath, which
                             leaves the map names readable however long they are. -->
                        <ComboBox x:Uid="Dashboard_Map" ItemsSource="{x:Bind ViewModel.Cleaning.Maps}" SelectedItem="{x:Bind ViewModel.Cleaning.SelectedMap, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource MapItemName}" HorizontalAlignment="Stretch"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Uid="Dashboard_MakeActive" Command="{x:Bind ViewModel.Cleaning.SetActiveMapCommand}"
                                    IsEnabled="{x:Bind local:Ui.CanSetActive(ViewModel.Cleaning.SelectedMap), Mode=OneWay}"/>
                            <Button x:Uid="Dashboard_ManageMaps" Command="{x:Bind ViewModel.ManageMapsCommand}"/>
                        </StackPanel>
                        <TextBlock x:Uid="Dashboard_RoomsInTheOrderYou" Style="{StaticResource Muted}" Margin="0,4,0,0"/>

                        <!-- Explains the four per-room settings once, rather than under each room. -->
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource Caption}">
                                <Run x:Uid="Dashboard_CleaningType" FontWeight="SemiBold"/><Run Text=" "/><Run x:Uid="Dashboard_WhatTheRobotShouldDo"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource Caption}">
                                <Run x:Uid="Dashboard_SuctionMode" FontWeight="SemiBold"/><Run Text=" "/><Run x:Uid="Dashboard_SetTheSuctionModeUsed"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource Caption}">
                                <Run x:Uid="Dashboard_WaterLevel" FontWeight="SemiBold"/><Run Text=" "/><Run x:Uid="Dashboard_SetHowMuchWaterYour"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource Caption}">
                                <Run x:Uid="Dashboard_MoppingPasses" FontWeight="SemiBold"/><Run Text=" "/><Run x:Uid="Dashboard_SetHowManyPassesYour"/>
                            </TextBlock>
                        </StackPanel>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.Cleaning.Zones}" ItemTemplate="{StaticResource RoomSettingsRow}"
                                      IsEnabled="{x:Bind ViewModel.Cleaning.RoomsEnabled, Mode=OneWay}" IsTabStop="False"/>
                        <Button x:Uid="Dashboard_CleansTheTickedRoomsIn" Command="{x:Bind ViewModel.Cleaning.StartCleanCommand}" IsEnabled="{x:Bind ViewModel.Cleaning.CanStart, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="14"/>
                                <TextBlock x:Uid="Dashboard_CleanTheSelection"/>
                            </StackPanel>
                        </Button>
                        <!-- A disabled button shows no tooltip here: why it cannot be pressed is said underneath. -->
                        <TextBlock x:Uid="Dashboard_TickAtLeastOneRoom" Style="{StaticResource Caption}"
                                   Visibility="{x:Bind local:Ui.Unless(ViewModel.Cleaning.CanStart), Mode=OneWay}"/>

                        <!-- A rectangle drawn on the map instead of whole rooms, as the phone's zone clean. -->
                        <TextBlock x:Uid="Dashboard_CleanAZone" Style="{StaticResource Section}" Margin="0,12,0,0"/>
                        <TextBlock x:Uid="Dashboard_DrawARectangleOnThe" Style="{StaticResource Caption}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{x:Bind ViewModel.Cleaning.DrawSpotLabel, Mode=OneWay}" Command="{x:Bind ViewModel.Cleaning.DrawSpotCommand}"/>
                            <Button Content="{x:Bind ViewModel.Cleaning.ClearSpotLabel, Mode=OneWay}" Command="{x:Bind ViewModel.Cleaning.ClearSpotCommand}"
                                    Visibility="{x:Bind ViewModel.Cleaning.HasSpot, Mode=OneWay}"/>
                        </StackPanel>
                        <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.Cleaning.HasSpot, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.Cleaning.SpotSizeText, Mode=OneWay}" Style="{StaticResource Muted}"/>
                            <ComboBox x:Uid="Dashboard_CleaningTypeOfTheZone" ItemsSource="{x:Bind ViewModel.Cleaning.SpotCleanTypes}" SelectedItem="{x:Bind ViewModel.Cleaning.SpotCleanType, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource CleanTypeItem}" HorizontalAlignment="Stretch"/>
                            <ComboBox x:Uid="Dashboard_SuctionModeOfTheZone" ItemsSource="{x:Bind ViewModel.Cleaning.SpotStrategies}" SelectedItem="{x:Bind ViewModel.Cleaning.SpotStrategy, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource StrategyItem}" HorizontalAlignment="Stretch"
                                      Visibility="{x:Bind ViewModel.Cleaning.SpotHasVacuum, Mode=OneWay}"/>
                            <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.Cleaning.SpotHasMop, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Uid="Dashboard_WaterLevelOfTheZone" ItemsSource="{x:Bind ViewModel.Cleaning.SpotWaterLevels}" SelectedItem="{x:Bind ViewModel.Cleaning.SpotWaterLevel, Mode=TwoWay}"
                                          ItemTemplate="{StaticResource WaterLevelItem}" HorizontalAlignment="Stretch"/>
                                <ComboBox x:Uid="Dashboard_MoppingPassesOfTheZone" Grid.Column="1" ItemsSource="{x:Bind ViewModel.Cleaning.SpotMopPasses}" SelectedItem="{x:Bind ViewModel.Cleaning.SpotMopPass, Mode=TwoWay}"
                                          ItemTemplate="{StaticResource MopPassesItem}" HorizontalAlignment="Stretch"/>
                            </Grid>
                            <Button Command="{x:Bind ViewModel.Cleaning.StartSpotCleanCommand}" IsEnabled="{x:Bind ViewModel.Cleaning.CanStartSpot, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}" Margin="0,4,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE768;" FontSize="14"/>
                                    <TextBlock x:Uid="Dashboard_CleanTheZone"/>
                                </StackPanel>
                            </Button>
                            <TextBlock x:Uid="Dashboard_TheRobotMustBeAvailable" Style="{StaticResource Caption}"
                                       Visibility="{x:Bind local:Ui.Unless(ViewModel.Cleaning.CanStartSpot), Mode=OneWay}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Dock -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="Dashboard_Dock" Style="{StaticResource Section}" Margin="0"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Uid="Dashboard_EmptyTheBin" Command="{x:Bind ViewModel.Status.CollectDustCommand}"/>
                            <Button Content="{x:Bind ViewModel.Status.WashDryLabel, Mode=OneWay}" Command="{x:Bind ViewModel.Status.WashDryCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Consumables -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="Dashboard_Consumables" Style="{StaticResource Section}" Margin="0"/>
                        <TextBlock x:Uid="Dashboard_LifeLeftReplaceAt0" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Status.Consumables}" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ConsumableItem">
                                    <Grid Margin="0,3" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center"/>
                                        <ProgressBar Grid.Column="1" Value="{x:Bind local:Ui.Number(Remaining)}" Maximum="100" VerticalAlignment="Center"
                                                     AutomationProperties.Name="{x:Bind Name}"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind Display}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Muted}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Right: the map -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12" Margin="0">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="Dashboard_Map2" Style="{StaticResource Section}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Uid="Dashboard_ResetZoom" Click="ResetZoom_Click"/>
                        <Button x:Uid="Dashboard_ExportAsPNG" Command="{x:Bind ViewModel.Cleaning.ExportMapCommand}"
                                Visibility="{x:Bind ViewModel.AppSettings.ShowExportButton, Mode=OneWay}"/>
                    </StackPanel>
                </Grid>
                <controls:MapView x:Uid="Dashboard_MapOfTheHome" x:Name="MapCanvas" Grid.Row="1" Interaction="{x:Bind ViewModel.Cleaning.Canvas}"/>
                <TextBlock x:Uid="Dashboard_ClickTapSelectsARoom" Grid.Row="2" Style="{StaticResource Caption}" Margin="4,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
