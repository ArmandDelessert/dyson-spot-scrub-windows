<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DyssCockpit.Presentation\DyssCockpit.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" />
    <PackageReference Include="Microsoft.Graphics.Win2D" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged, and carrying the Windows App SDK with it: an unzipped folder runs as it is,
         with nothing to install. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The executable is named after the application; the code keeps the project's namespace. -->
    <AssemblyName>DyssCockpit</AssemblyName>
    <!-- The robot heading down with its light on, written by DyssCockpit.exe with its export-icon
         option (see AppIcon in Rendering/MapImage.cs). The executable, the window and the taskbar take it from here. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Program.cs has the entry point: it keeps the application to one instance. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!-- A self-contained Windows App SDK needs an architecture: the machine's own, unless one is asked for. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == ''">
    <RuntimeIdentifier Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <!-- The window's icon, read at run time, and the notification area's: the same, or with a red
         badge while the robot reports a fault (export-icon with its alert option). -->
    <Content Include="app.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="app-alert.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The Windows App SDK's component packages leave out one file of its runtime when the app carries
    the SDK itself: Microsoft.WindowsAppRuntime.Insights.Resource.dll, without which registering
    for app notifications fails with "module not found". It is taken at build time from the SDK's
    own runtime package, the version the full SDK package pins for these components.
  -->
  <PropertyGroup>
    <WindowsAppRuntimeVersion>2.5.1</WindowsAppRuntimeVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageDownload Include="Microsoft.WindowsAppSDK.Runtime" Version="[$(WindowsAppRuntimeVersion)]" />
  </ItemGroup>
  <Target Name="AddWindowsAppRuntimeInsights" BeforeTargets="AssignTargetPaths">
    <!-- Worked out here rather than with the project's properties: the intermediate folder is only
         known once the SDK has set it, and it is per architecture. -->
    <PropertyGroup>
      <WindowsAppRuntimeMsix>$(NuGetPackageRoot)microsoft.windowsappsdk.runtime/$(WindowsAppRuntimeVersion)/tools/MSIX/win10-$(RuntimeIdentifier.Replace('win-', ''))/Microsoft.WindowsAppRuntime.2.msix</WindowsAppRuntimeMsix>
      <WindowsAppRuntimeExtracted>$(IntermediateOutputPath)WindowsAppRuntime/</WindowsAppRuntimeExtracted>
    </PropertyGroup>
    <Unzip SourceFiles="$(WindowsAppRuntimeMsix)" DestinationFolder="$(WindowsAppRuntimeExtracted)"
           Include="Microsoft.WindowsAppRuntime.Insights.Resource.dll" SkipUnchangedFiles="true" />
    <!-- Copied when it differs rather than when it is newer: the file keeps its date from the
         package, and another version of the runtime can carry an older one. -->
    <ItemGroup>
      <None Include="$(WindowsAppRuntimeExtracted)Microsoft.WindowsAppRuntime.Insights.Resource.dll"
            Link="Microsoft.WindowsAppRuntime.Insights.Resource.dll"
            CopyToOutputDirectory="IfDifferent" CopyToPublishDirectory="IfDifferent" />
    </ItemGroup>
  </Target>

</Project>
