<Project Sdk="Microsoft.NET.Sdk">

  <!-- Identity and target: what the executable is called, which Windows it runs on, its icon. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- The executable is named after the application; the code keeps the project's namespace. -->
    <AssemblyName>DyssCockpit</AssemblyName>
    <AssemblyTitle>DySS Cockpit</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The robot heading down with its light on, written by DyssCockpit.exe with its export-icon
         option (see AppIcon in Rendering/MapImage.cs). The executable, the window and the taskbar take it from here. -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- WinUI 3, unpackaged, and carrying the Windows App SDK with it: an unzipped folder runs as it is,
       with nothing to install. -->
  <PropertyGroup>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Program.cs has the entry point: it keeps the application to one instance. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!--
    A self-contained Windows App SDK needs an architecture: the machine's own unless one is asked for
    (dotnet build -r win-x64). The OS architecture, not the SDK's: an x64 SDK on an ARM64 PC would otherwise
    give win-x64, and a non-Windows SDK a non-Windows identifier.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == ''">
    <RuntimeIdentifier Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <!-- The window's icon, read at run time, and the notification area's: the same, or with a red
         badge while the robot reports a fault (export-icon with its alert option). -->
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Only the Windows App SDK components the app uses (versions in Directory.Packages.props).
    The Microsoft.WindowsAppSDK metapackage would also bundle the AI/ML runtimes (onnxruntime, DirectML…),
    roughly doubling the size of the self-contained output.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" />
    <!-- Its build targets check that the components above are versions that go together, and the
         Insights file below comes out of its MSIX. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Graphics.Win2D" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DyssCockpit.Core\DyssCockpit.Core.csproj" />
    <ProjectReference Include="..\DyssCockpit.Presentation\DyssCockpit.Presentation.csproj" />
  </ItemGroup>

  <!--
    Workaround: self-contained builds of Windows App SDK 2.x omit Microsoft.WindowsAppRuntime.Insights.Resource.dll
    (it only ships inside the runtime MSIX), and AppNotificationManager.Register then fails with 0x8007007E.
    Extract it from the MSIX matching the target architecture and deploy it next to the executable.
  -->
  <Target Name="AddWindowsAppRuntimeInsightsResource" BeforeTargets="AssignTargetPaths">
    <PropertyGroup>
      <_InsightsArch>$(RuntimeIdentifier.Replace('win-', ''))</_InsightsArch>
      <_InsightsMsix>$(NuGetPackageRoot)microsoft.windowsappsdk.runtime\$(WindowsAppSdkVersion)\tools\MSIX\win10-$(_InsightsArch)\Microsoft.WindowsAppRuntime.2.msix</_InsightsMsix>
      <_InsightsFolder>$(IntermediateOutputPath)WindowsAppRuntimeInsights\</_InsightsFolder>
    </PropertyGroup>
    <Unzip Condition="Exists('$(_InsightsMsix)')" SourceFiles="$(_InsightsMsix)" DestinationFolder="$(_InsightsFolder)" Include="Microsoft.WindowsAppRuntime.Insights.Resource.dll" SkipUnchangedFiles="true" />
    <Warning Condition="!Exists('$(_InsightsMsix)')" Text="Windows App SDK runtime MSIX not found at $(_InsightsMsix); notifications may not work." />
    <!-- Copied when it differs rather than when it is newer: the file keeps its date from the
         package, and another version of the runtime can carry an older one. -->
    <ItemGroup Condition="Exists('$(_InsightsFolder)Microsoft.WindowsAppRuntime.Insights.Resource.dll')">
      <None Include="$(_InsightsFolder)Microsoft.WindowsAppRuntime.Insights.Resource.dll" Link="Microsoft.WindowsAppRuntime.Insights.Resource.dll" CopyToOutputDirectory="IfDifferent" CopyToPublishDirectory="IfDifferent" />
    </ItemGroup>
  </Target>

</Project>
