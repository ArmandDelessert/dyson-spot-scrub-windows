<Window x:Class="Dyss.App.Views.ConnectionWaitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DySS Cockpit" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <ResourceDictionary Source="/Themes/Controls.xaml"/>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock Text="Impossible de joindre le cloud Dyson" Style="{StaticResource Section}"/>
        <TextBlock x:Name="Reason" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
        <TextBlock TextWrapping="Wrap">
            Le réseau n'est peut-être pas encore connecté. L'application réessaie d'elle-même, et tout de suite dès que Windows signale le retour du réseau.
        </TextBlock>
        <TextBlock x:Name="Countdown" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,-8">
            <Button Content="Quitter" IsCancel="True" Style="{StaticResource Secondary}" MinWidth="100"/>
            <Button Content="Réessayer maintenant" IsDefault="True" Click="Retry_Click" Margin="0,0,0,8" MinWidth="100"/>
        </StackPanel>
    </StackPanel>
</Window>
