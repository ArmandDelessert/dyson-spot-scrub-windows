<UserControl x:Class="Dyss.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Dyss.App"
             xmlns:controls="using:Dyss.App.Controls"
             xmlns:vm="using:Dyss.Presentation.ViewModels">
    <Grid Padding="16,0,16,16" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="370"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Left column: the robot, the clean, the dock, the consumables. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="0,0,14,0">

                <!-- State -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.Status.StateText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <TextBlock Text="{x:Bind ViewModel.Status.ActionText, Mode=OneWay}" Style="{StaticResource Muted}"
                                   Visibility="{x:Bind local:Ui.IfAny(ViewModel.Status.ActionText), Mode=OneWay}"/>
                        <TextBlock Text='{local:Tr Fr="Retour à la station pour laver le rouleau humide", En="Going back to the dock to wash the mop roller"}' Style="{StaticResource Muted}"
                                   Visibility="{x:Bind ViewModel.Status.ReturningToWash, Mode=OneWay}"/>
                        <TextBlock Text="{x:Bind ViewModel.Status.DockText, Mode=OneWay}" Style="{StaticResource Muted}"
                                   Visibility="{x:Bind ViewModel.Status.DockBusy, Mode=OneWay}"/>
                        <TextBlock Text="{x:Bind ViewModel.Status.FaultText, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   Visibility="{x:Bind ViewModel.Status.HasRealFault, Mode=OneWay}"/>
                        <Grid Margin="0,10,0,0">
                            <TextBlock Text='{local:Tr Fr="Batterie", En="Battery"}' Style="{StaticResource Muted}"/>
                            <TextBlock Text="{x:Bind local:Ui.Percent(ViewModel.Status.Battery), Mode=OneWay}" HorizontalAlignment="Right"/>
                        </Grid>
                        <ProgressBar Value="{x:Bind local:Ui.Number(ViewModel.Status.Battery), Mode=OneWay}" Maximum="100" Margin="0,4,0,0"
                                     Foreground="{ThemeResource SystemFillColorSuccessBrush}" AutomationProperties.Name='{local:Tr Fr="Batterie", En="Battery"}'/>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                            <Button Command="{x:Bind ViewModel.Status.PauseResumeCommand}" IsEnabled="{x:Bind ViewModel.Status.CanPause, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="{x:Bind local:Ui.PauseGlyph(ViewModel.Status.Paused), Mode=OneWay}" FontSize="14"/>
                                    <TextBlock Text="{x:Bind ViewModel.Status.PauseResumeLabel, Mode=OneWay}"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.Status.AbortCommand}" IsEnabled="{x:Bind ViewModel.Status.CanAbort, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE80F;" FontSize="14"/>
                                    <TextBlock Text='{local:Tr Fr="Retour à la station", En="Return to dock"}'/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Clean -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="8">
                        <TextBlock Text='{local:Tr Fr="Nettoyage", En="Cleaning"}' Style="{StaticResource Section}" Margin="0"/>
                        <!-- The picker gets the full width; its two actions sit underneath, which
                             leaves the map names readable however long they are. -->
                        <ComboBox Header='{local:Tr Fr="Carte", En="Map"}' ItemsSource="{x:Bind ViewModel.Cleaning.Maps}" SelectedItem="{x:Bind ViewModel.Cleaning.SelectedMap, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource MapItemName}" HorizontalAlignment="Stretch"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content='{local:Tr Fr="Définir comme active", En="Make active"}' Command="{x:Bind ViewModel.Cleaning.SetActiveMapCommand}"
                                    IsEnabled="{x:Bind local:Ui.CanSetActive(ViewModel.Cleaning.SelectedMap), Mode=OneWay}"/>
                            <Button Content='{local:Tr Fr="Gérer les cartes…", En="Manage maps…"}' Command="{x:Bind ViewModel.ManageMapsCommand}"
                                    ToolTipService.ToolTip='{local:Tr Fr="Renommer les cartes et les pièces, fusionner ou diviser des pièces, lancer une cartographie", En="Rename maps and rooms, merge or split rooms, start mapping"}'/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                   Text='{local:Tr Fr="Pièces, dans l&apos;ordre de passage souhaité. Cochez-les ici ou cliquez-les sur la carte. Cliquez une pièce cochée pour replier ou déplier ses réglages.", En="Rooms, in the order you want them cleaned. Tick them here or click them on the map. Click a ticked room to fold or unfold its settings."}'/>

                        <!-- Explains the four per-room settings once, rather than under each room. -->
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource Caption}">
                                <Run FontWeight="SemiBold" Text='{local:Tr Fr="Type de nettoyage : ", En="Cleaning type: "}'/><Run Text='{local:Tr Fr="ce que le robot doit faire dans la pièce.", En="what the robot should do in the room."}'/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource Caption}">
                                <Run FontWeight="SemiBold" Text='{local:Tr Fr="Mode d&apos;aspiration : ", En="Suction mode: "}'/><Run Text='{local:Tr Fr="définissez le mode d&apos;aspiration utilisé pour nettoyer le sol.", En="set the suction mode used to clean the floor."}'/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource Caption}">
                                <Run FontWeight="SemiBold" Text='{local:Tr Fr="Niveau d&apos;hydratation : ", En="Water level: "}'/><Run Text='{local:Tr Fr="définissez la quantité d&apos;eau que votre robot utilise pour laver le sol.", En="set how much water your robot uses to mop the floor."}'/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource Caption}">
                                <Run FontWeight="SemiBold" Text='{local:Tr Fr="Répétitions de lavage : ", En="Mopping passes: "}'/><Run Text='{local:Tr Fr="définissez combien de passages votre robot doit effectuer pour laver le sol.", En="set how many passes your robot makes to mop the floor."}'/>
                            </TextBlock>
                        </StackPanel>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.Cleaning.Zones}" ItemTemplate="{StaticResource RoomSettingsRow}"
                                      IsEnabled="{x:Bind ViewModel.Cleaning.RoomsEnabled, Mode=OneWay}" IsTabStop="False"/>
                        <Button Command="{x:Bind ViewModel.Cleaning.StartCleanCommand}" IsEnabled="{x:Bind ViewModel.Cleaning.CanStart, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}" Margin="0,4,0,0"
                                ToolTipService.ToolTip='{local:Tr Fr="Lance le nettoyage des pièces cochées, dans l&apos;ordre indiqué.", En="Cleans the ticked rooms, in the order shown."}'>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="14"/>
                                <TextBlock Text='{local:Tr Fr="Nettoyer la sélection", En="Clean the selection"}'/>
                            </StackPanel>
                        </Button>
                        <!-- A disabled button shows no tooltip here: why it cannot be pressed is said underneath. -->
                        <TextBlock Style="{StaticResource Caption}" Text='{local:Tr Fr="Cochez au moins une pièce, sans zone tracée ; le robot doit aussi être disponible.", En="Tick at least one room, with no zone drawn; the robot must also be available."}'
                                   Visibility="{x:Bind local:Ui.Unless(ViewModel.Cleaning.CanStart), Mode=OneWay}"/>

                        <!-- A rectangle drawn on the map instead of whole rooms, as the phone's zone clean. -->
                        <TextBlock Text='{local:Tr Fr="Nettoyer une zone", En="Clean a zone"}' Style="{StaticResource Section}" Margin="0,12,0,0"/>
                        <TextBlock Style="{StaticResource Caption}"
                                   Text='{local:Tr Fr="Tracez un rectangle sur la carte en cliquant deux coins opposés, choisissez comment le nettoyer, puis lancez : le robot ne nettoie que cette zone. Faites-la glisser pour la déplacer, tirez ses coins pour la redimensionner ; un clic dans le vide de la carte ou la touche Échap l&apos;efface (Échap abandonne aussi un tracé ou un déplacement en cours). Tant qu&apos;une zone est tracée, les pièces ne peuvent pas être cochées.", En="Draw a rectangle on the map by clicking two opposite corners, choose how to clean it, then start: the robot cleans only that zone. Drag it to move it, pull its corners to resize it; a click on an empty part of the map or the Esc key erases it (Esc also cancels a drawing or a move in progress). While a zone is drawn, rooms cannot be ticked."}'/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{x:Bind ViewModel.Cleaning.DrawSpotLabel, Mode=OneWay}" Command="{x:Bind ViewModel.Cleaning.DrawSpotCommand}"/>
                            <Button Content='{local:Tr Fr="Effacer la zone", En="Erase the zone"}' Command="{x:Bind ViewModel.Cleaning.ClearSpotCommand}"
                                    Visibility="{x:Bind ViewModel.Cleaning.HasSpot, Mode=OneWay}"/>
                        </StackPanel>
                        <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.Cleaning.HasSpot, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.Cleaning.SpotSizeText, Mode=OneWay}" Style="{StaticResource Muted}"/>
                            <ComboBox ItemsSource="{x:Bind ViewModel.Cleaning.SpotCleanTypes}" SelectedItem="{x:Bind ViewModel.Cleaning.SpotCleanType, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource CleanTypeItem}" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name='{local:Tr Fr="Type de nettoyage de la zone", En="Cleaning type of the zone"}'/>
                            <ComboBox ItemsSource="{x:Bind ViewModel.Cleaning.SpotStrategies}" SelectedItem="{x:Bind ViewModel.Cleaning.SpotStrategy, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource StrategyItem}" HorizontalAlignment="Stretch"
                                      Visibility="{x:Bind ViewModel.Cleaning.SpotHasVacuum, Mode=OneWay}" AutomationProperties.Name='{local:Tr Fr="Mode d&apos;aspiration de la zone", En="Suction mode of the zone"}'/>
                            <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.Cleaning.SpotHasMop, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{x:Bind ViewModel.Cleaning.SpotWaterLevels}" SelectedItem="{x:Bind ViewModel.Cleaning.SpotWaterLevel, Mode=TwoWay}"
                                          ItemTemplate="{StaticResource WaterLevelItem}" HorizontalAlignment="Stretch"
                                          AutomationProperties.Name='{local:Tr Fr="Niveau d&apos;eau de la zone", En="Water level of the zone"}'/>
                                <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.Cleaning.SpotMopPasses}" SelectedItem="{x:Bind ViewModel.Cleaning.SpotMopPass, Mode=TwoWay}"
                                          ItemTemplate="{StaticResource MopPassesItem}" HorizontalAlignment="Stretch"
                                          AutomationProperties.Name='{local:Tr Fr="Passages de lavage de la zone", En="Mopping passes of the zone"}'/>
                            </Grid>
                            <Button Command="{x:Bind ViewModel.Cleaning.StartSpotCleanCommand}" IsEnabled="{x:Bind ViewModel.Cleaning.CanStartSpot, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}" Margin="0,4,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE768;" FontSize="14"/>
                                    <TextBlock Text='{local:Tr Fr="Nettoyer la zone", En="Clean the zone"}'/>
                                </StackPanel>
                            </Button>
                            <TextBlock Style="{StaticResource Caption}" Text='{local:Tr Fr="Le robot doit être disponible (sur sa station ou à l&apos;arrêt).", En="The robot must be available (on its dock or stopped)."}'
                                       Visibility="{x:Bind local:Ui.Unless(ViewModel.Cleaning.CanStartSpot), Mode=OneWay}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Dock -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="8">
                        <TextBlock Text='{local:Tr Fr="Station", En="Dock"}' Style="{StaticResource Section}" Margin="0"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content='{local:Tr Fr="Vider le collecteur", En="Empty the bin"}' Command="{x:Bind ViewModel.Status.CollectDustCommand}"/>
                            <Button Content="{x:Bind ViewModel.Status.WashDryLabel, Mode=OneWay}" Command="{x:Bind ViewModel.Status.WashDryCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Consumables -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="4">
                        <TextBlock Text='{local:Tr Fr="Consommables", En="Consumables"}' Style="{StaticResource Section}" Margin="0"/>
                        <TextBlock Text='{local:Tr Fr="Durée de vie restante. À remplacer à 0 %.", En="Life left. Replace at 0 %."}' Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Status.Consumables}" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ConsumableItem">
                                    <Grid Margin="0,3" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center"/>
                                        <ProgressBar Grid.Column="1" Value="{x:Bind local:Ui.Number(Remaining)}" Maximum="100" VerticalAlignment="Center"
                                                     AutomationProperties.Name="{x:Bind Name}"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind Display}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Muted}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Right: the map -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12" Margin="0">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text='{local:Tr Fr="Carte", En="Map"}' Style="{StaticResource Section}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <!-- Display preferences sit with the map they change, rather than with the
                             robot's settings, which are all sent to the robot. They apply to the
                             history map too. -->
                        <DropDownButton Content='{local:Tr Fr="Affichage", En="Display"}' AutomationProperties.Name='{local:Tr Fr="Options d&apos;affichage de la carte", En="Map display options"}'>
                            <DropDownButton.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <StackPanel MaxWidth="300">
                                        <CheckBox IsChecked="{x:Bind ViewModel.Display.ShowFurniture, Mode=TwoWay}" Content='{local:Tr Fr="Afficher les meubles", En="Show furniture"}'/>
                                        <CheckBox IsChecked="{x:Bind ViewModel.Display.ShowTravelPath, Mode=TwoWay}" Content='{local:Tr Fr="Afficher les déplacements sans nettoyage", En="Show travel without cleaning"}'/>
                                        <CheckBox IsChecked="{x:Bind ViewModel.Display.ShowCleanedArea, Mode=TwoWay}" Content='{local:Tr Fr="Afficher la surface nettoyée", En="Show the cleaned area"}'
                                                  ToolTipService.ToolTip='{local:Tr Fr="Élargit le trajet à la largeur du robot, là où il a nettoyé.", En="Widens the path to the robot&apos;s width where it cleaned."}'/>
                                        <CheckBox IsChecked="{x:Bind ViewModel.Display.ShowExportButton, Mode=TwoWay}" Content='{local:Tr Fr="Afficher le bouton d&apos;export PNG", En="Show the PNG export button"}'/>
                                        <CheckBox IsChecked="{x:Bind ViewModel.Display.SmoothRobotMotion, Mode=TwoWay}" Content='{local:Tr Fr="Lisser les déplacements du robot", En="Smooth the robot&apos;s movements"}'
                                                  ToolTipService.ToolTip='{local:Tr Fr="Le robot glisse d&apos;une position à la suivante au lieu de sauter, avec un léger retard.", En="The robot glides from one position to the next instead of jumping, with a slight delay."}'/>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                                   Text='{local:Tr Fr="Ces réglages ne concernent que cet affichage : rien n&apos;est envoyé au robot.", En="These settings only affect this display: nothing is sent to the robot."}'/>
                                    </StackPanel>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <Button Content='{local:Tr Fr="Réinitialiser le zoom", En="Reset zoom"}' Click="ResetZoom_Click"/>
                        <Button Content='{local:Tr Fr="Exporter en PNG", En="Export as PNG"}' Command="{x:Bind ViewModel.Cleaning.ExportMapCommand}"
                                Visibility="{x:Bind ViewModel.Display.ShowExportButton, Mode=OneWay}"/>
                    </StackPanel>
                </Grid>
                <controls:MapView x:Name="MapCanvas" Grid.Row="1" Interaction="{x:Bind ViewModel.Cleaning.Canvas}"
                                  AutomationProperties.Name='{local:Tr Fr="Carte de la maison", En="Map of the home"}'/>
                <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Margin="4,0"
                           Text='{local:Tr Fr="Clic/tape : sélectionne une pièce, efface la sélection en dehors. Double-clic/double-tape en dehors : réinitialise le zoom. Molette ou pincement pour zoomer, glisser pour déplacer.", En="Click/tap: selects a room, clears the selection outside one. Double-click/double-tap outside: resets the zoom. Wheel or pinch to zoom, drag to move."}'/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
