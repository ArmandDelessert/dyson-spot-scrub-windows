<UserControl x:Class="Dyss.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Dyss.App"
             xmlns:controls="using:Dyss.App.Controls"
             xmlns:vm="using:Dyss.Presentation.ViewModels">
    <Grid Padding="16,0,16,16" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="370"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Left column: the robot, the clean, the dock, the consumables. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="0,0,14,0">

                <!-- State -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.Status.StateText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <TextBlock Text="{x:Bind ViewModel.Status.ActionText, Mode=OneWay}" Style="{StaticResource Muted}"
                                   Visibility="{x:Bind local:Ui.IfAny(ViewModel.Status.ActionText), Mode=OneWay}"/>
                        <TextBlock Text="Retour à la station pour laver le rouleau humide" Style="{StaticResource Muted}"
                                   Visibility="{x:Bind ViewModel.Status.ReturningToWash, Mode=OneWay}"/>
                        <TextBlock Text="{x:Bind ViewModel.Status.DockText, Mode=OneWay}" Style="{StaticResource Muted}"
                                   Visibility="{x:Bind ViewModel.Status.DockBusy, Mode=OneWay}"/>
                        <TextBlock Text="{x:Bind ViewModel.Status.FaultText, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   Visibility="{x:Bind ViewModel.Status.HasRealFault, Mode=OneWay}"/>
                        <Grid Margin="0,10,0,0">
                            <TextBlock Text="Batterie" Style="{StaticResource Muted}"/>
                            <TextBlock Text="{x:Bind local:Ui.Percent(ViewModel.Status.Battery), Mode=OneWay}" HorizontalAlignment="Right"/>
                        </Grid>
                        <ProgressBar Value="{x:Bind local:Ui.Number(ViewModel.Status.Battery), Mode=OneWay}" Maximum="100" Margin="0,4,0,0"
                                     Foreground="{ThemeResource SystemFillColorSuccessBrush}" AutomationProperties.Name="Batterie"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                            <Button Command="{x:Bind ViewModel.Status.PauseResumeCommand}" IsEnabled="{x:Bind ViewModel.Status.CanPause, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="{x:Bind local:Ui.PauseGlyph(ViewModel.Status.Paused), Mode=OneWay}" FontSize="14"/>
                                    <TextBlock Text="{x:Bind ViewModel.Status.PauseResumeLabel, Mode=OneWay}"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.Status.AbortCommand}" IsEnabled="{x:Bind ViewModel.Status.CanAbort, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE80F;" FontSize="14"/>
                                    <TextBlock Text="Retour à la station"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Clean -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Nettoyage" Style="{StaticResource Section}" Margin="0"/>
                        <!-- The picker gets the full width; its two actions sit underneath, which
                             leaves the map names readable however long they are. -->
                        <ComboBox Header="Carte" ItemsSource="{x:Bind ViewModel.Cleaning.Maps}" SelectedItem="{x:Bind ViewModel.Cleaning.SelectedMap, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource MapItemName}" HorizontalAlignment="Stretch"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Définir comme active" Command="{x:Bind ViewModel.Cleaning.SetActiveMapCommand}"
                                    IsEnabled="{x:Bind local:Ui.CanSetActive(ViewModel.Cleaning.SelectedMap), Mode=OneWay}"/>
                            <Button Content="Gérer les cartes…" Command="{x:Bind ViewModel.ManageMapsCommand}"
                                    ToolTipService.ToolTip="Renommer les cartes et les pièces, fusionner ou diviser des pièces, lancer une cartographie"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                   Text="Pièces, dans l'ordre de passage souhaité. Cochez-les ici ou cliquez-les sur la carte. Cliquez une pièce cochée pour replier ou déplier ses réglages."/>

                        <!-- Explains the four per-room settings once, rather than under each room. -->
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource Caption}">
                                <Run FontWeight="SemiBold" Text="Type de nettoyage : "/><Run Text="ce que le robot doit faire dans la pièce."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource Caption}">
                                <Run FontWeight="SemiBold" Text="Mode d'aspiration : "/><Run Text="définissez le mode d'aspiration utilisé pour nettoyer le sol."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource Caption}">
                                <Run FontWeight="SemiBold" Text="Niveau d'hydratation : "/><Run Text="définissez la quantité d'eau que votre robot utilise pour laver le sol."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource Caption}">
                                <Run FontWeight="SemiBold" Text="Répétitions de lavage : "/><Run Text="définissez combien de passages votre robot doit effectuer pour laver le sol."/>
                            </TextBlock>
                        </StackPanel>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.Cleaning.Zones}" ItemTemplate="{StaticResource RoomSettingsRow}"
                                      IsEnabled="{x:Bind ViewModel.Cleaning.RoomsEnabled, Mode=OneWay}" IsTabStop="False"/>
                        <Button Command="{x:Bind ViewModel.Cleaning.StartCleanCommand}" IsEnabled="{x:Bind ViewModel.Cleaning.CanStart, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}" Margin="0,4,0,0"
                                ToolTipService.ToolTip="Lance le nettoyage des pièces cochées, dans l'ordre indiqué.">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="14"/>
                                <TextBlock Text="Nettoyer la sélection"/>
                            </StackPanel>
                        </Button>
                        <!-- A disabled button shows no tooltip here: why it cannot be pressed is said underneath. -->
                        <TextBlock Style="{StaticResource Caption}" Text="Cochez au moins une pièce, sans zone tracée ; le robot doit aussi être disponible."
                                   Visibility="{x:Bind local:Ui.Unless(ViewModel.Cleaning.CanStart), Mode=OneWay}"/>

                        <!-- A rectangle drawn on the map instead of whole rooms, as the phone's zone clean. -->
                        <TextBlock Text="Nettoyer une zone" Style="{StaticResource Section}" Margin="0,12,0,0"/>
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="Tracez un rectangle sur la carte en cliquant deux coins opposés, choisissez comment le nettoyer, puis lancez : le robot ne nettoie que cette zone. Faites-la glisser pour la déplacer, tirez ses coins pour la redimensionner ; un clic dans le vide de la carte ou la touche Échap l'efface (Échap abandonne aussi un tracé ou un déplacement en cours). Tant qu'une zone est tracée, les pièces ne peuvent pas être cochées."/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{x:Bind ViewModel.Cleaning.DrawSpotLabel, Mode=OneWay}" Command="{x:Bind ViewModel.Cleaning.DrawSpotCommand}"/>
                            <Button Content="Effacer la zone" Command="{x:Bind ViewModel.Cleaning.ClearSpotCommand}"
                                    Visibility="{x:Bind ViewModel.Cleaning.HasSpot, Mode=OneWay}"/>
                        </StackPanel>
                        <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.Cleaning.HasSpot, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.Cleaning.SpotSizeText, Mode=OneWay}" Style="{StaticResource Muted}"/>
                            <ComboBox ItemsSource="{x:Bind ViewModel.Cleaning.SpotCleanTypes}" SelectedItem="{x:Bind ViewModel.Cleaning.SpotCleanType, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource CleanTypeItem}" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Type de nettoyage de la zone"/>
                            <ComboBox ItemsSource="{x:Bind ViewModel.Cleaning.SpotStrategies}" SelectedItem="{x:Bind ViewModel.Cleaning.SpotStrategy, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource StrategyItem}" HorizontalAlignment="Stretch"
                                      Visibility="{x:Bind ViewModel.Cleaning.SpotHasVacuum, Mode=OneWay}" AutomationProperties.Name="Mode d'aspiration de la zone"/>
                            <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.Cleaning.SpotHasMop, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{x:Bind ViewModel.Cleaning.SpotWaterLevels}" SelectedItem="{x:Bind ViewModel.Cleaning.SpotWaterLevel, Mode=TwoWay}"
                                          ItemTemplate="{StaticResource WaterLevelItem}" HorizontalAlignment="Stretch"
                                          AutomationProperties.Name="Niveau d'eau de la zone"/>
                                <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.Cleaning.SpotMopPasses}" SelectedItem="{x:Bind ViewModel.Cleaning.SpotMopPass, Mode=TwoWay}"
                                          ItemTemplate="{StaticResource MopPassesItem}" HorizontalAlignment="Stretch"
                                          AutomationProperties.Name="Passages de lavage de la zone"/>
                            </Grid>
                            <Button Command="{x:Bind ViewModel.Cleaning.StartSpotCleanCommand}" IsEnabled="{x:Bind ViewModel.Cleaning.CanStartSpot, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}" Margin="0,4,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE768;" FontSize="14"/>
                                    <TextBlock Text="Nettoyer la zone"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Style="{StaticResource Caption}" Text="Le robot doit être disponible (sur sa station ou à l'arrêt)."
                                       Visibility="{x:Bind local:Ui.Unless(ViewModel.Cleaning.CanStartSpot), Mode=OneWay}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Dock -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Station" Style="{StaticResource Section}" Margin="0"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Vider le collecteur" Command="{x:Bind ViewModel.Status.CollectDustCommand}"/>
                            <Button Content="{x:Bind ViewModel.Status.WashDryLabel, Mode=OneWay}" Command="{x:Bind ViewModel.Status.WashDryCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Consumables -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Consommables" Style="{StaticResource Section}" Margin="0"/>
                        <TextBlock Text="Durée de vie restante. À remplacer à 0 %." Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Status.Consumables}" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ConsumableItem">
                                    <Grid Margin="0,3" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center"/>
                                        <ProgressBar Grid.Column="1" Value="{x:Bind local:Ui.Number(Remaining)}" Maximum="100" VerticalAlignment="Center"
                                                     AutomationProperties.Name="{x:Bind Name}"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind Display}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Muted}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Right: the map -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12" Margin="0">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Carte" Style="{StaticResource Section}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <!-- Display preferences sit with the map they change, rather than with the
                             robot's settings, which are all sent to the robot. They apply to the
                             history map too. -->
                        <DropDownButton Content="Affichage" AutomationProperties.Name="Options d'affichage de la carte">
                            <DropDownButton.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <StackPanel MaxWidth="300">
                                        <CheckBox IsChecked="{x:Bind ViewModel.Display.ShowFurniture, Mode=TwoWay}" Content="Afficher les meubles"/>
                                        <CheckBox IsChecked="{x:Bind ViewModel.Display.ShowTravelPath, Mode=TwoWay}" Content="Afficher les déplacements sans nettoyage"/>
                                        <CheckBox IsChecked="{x:Bind ViewModel.Display.ShowExportButton, Mode=TwoWay}" Content="Afficher le bouton d'export PNG"/>
                                        <CheckBox IsChecked="{x:Bind ViewModel.Display.SmoothRobotMotion, Mode=TwoWay}" Content="Lisser les déplacements du robot"
                                                  ToolTipService.ToolTip="Le robot glisse d'une position à la suivante au lieu de sauter, avec un léger retard."/>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                                   Text="Ces réglages ne concernent que cet affichage : rien n'est envoyé au robot."/>
                                    </StackPanel>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <Button Content="Réinitialiser le zoom" Click="ResetZoom_Click"/>
                        <Button Content="Exporter en PNG" Command="{x:Bind ViewModel.Cleaning.ExportMapCommand}"
                                Visibility="{x:Bind ViewModel.Display.ShowExportButton, Mode=OneWay}"/>
                    </StackPanel>
                </Grid>
                <controls:MapView x:Name="MapCanvas" Grid.Row="1" Interaction="{x:Bind ViewModel.Cleaning.Canvas}"
                                  AutomationProperties.Name="Carte de la maison"/>
                <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Margin="4,0"
                           Text="Clic/tape : sélectionne une pièce, efface la sélection en dehors. Double-clic/double-tape en dehors : réinitialise le zoom. Molette ou pincement pour zoomer, glisser pour déplacer."/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
