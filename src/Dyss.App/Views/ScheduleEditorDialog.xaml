<ContentDialog x:Class="Dyss.App.Views.ScheduleEditorDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:local="using:Dyss.App"
               xmlns:vm="using:Dyss.Presentation.ViewModels"
               Title="{x:Bind ViewModel.Title}"
               PrimaryButtonText="Enregistrer" CloseButtonText="Annuler" DefaultButton="Primary"
               IsPrimaryButtonEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}">
    <StackPanel Spacing="12" Width="560">
        <TextBlock Text="{x:Bind ViewModel.MapText}" Style="{StaticResource Muted}"/>

        <!-- Start time and days -->
        <StackPanel Spacing="6">
            <TextBlock Text="Heure de début"/>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <ComboBox x:Name="HourBox" Width="90" SelectedIndex="{x:Bind ViewModel.Hour, Mode=TwoWay}" AutomationProperties.Name="Heure"/>
                <TextBlock Text=":" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ComboBox x:Name="MinuteBox" Width="90" SelectedIndex="{x:Bind ViewModel.Minute, Mode=TwoWay}" AutomationProperties.Name="Minutes"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="Jours"/>
            <ItemsControl ItemsSource="{x:Bind ViewModel.Days}" IsTabStop="False" AutomationProperties.Name="Jours de la semaine">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DayOption">
                        <ToggleButton Content="{x:Bind Letter}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" Width="44" Height="36"
                                      ToolTipService.ToolTip="{x:Bind Name}" AutomationProperties.Name="{x:Bind Name}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Pièces, dans l'ordre de passage. Cochez-les, puis réglez chacune comme pour un nettoyage lancé à la main."
                       TextWrapping="Wrap" VerticalAlignment="Bottom"/>
            <Button Grid.Column="1" Content="Tout décocher" Command="{x:Bind ViewModel.ClearRoomsCommand}" VerticalAlignment="Bottom"/>
        </Grid>
        <ItemsControl ItemsSource="{x:Bind ViewModel.Rooms}" ItemTemplate="{StaticResource RoomSettingsRow}" IsTabStop="False"
                      AutomationProperties.Name="Pièces de la carte"/>

        <!-- Why saving is not possible yet, and what the schedule will take. -->
        <StackPanel Spacing="2">
            <TextBlock Text="{x:Bind ViewModel.Missing, Mode=OneWay}" Style="{StaticResource Muted}"
                       Visibility="{x:Bind local:Ui.IfAny(ViewModel.Missing), Mode=OneWay}"/>
            <TextBlock Text="{x:Bind ViewModel.EstimateText, Mode=OneWay}" Style="{StaticResource Caption}"/>
            <TextBlock Text="{x:Bind ViewModel.OverlapWarning, Mode=OneWay}" Style="{StaticResource Warning}"
                       Visibility="{x:Bind local:Ui.IfAny(ViewModel.OverlapWarning), Mode=OneWay}"/>
        </StackPanel>
    </StackPanel>
</ContentDialog>
