<Window x:Class="Dyss.App.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <ResourceDictionary Source="/Themes/Controls.xaml"/>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBox x:Name="Input" Padding="6,4" Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}"
                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,-8">
            <Button Content="Annuler" IsCancel="True" Style="{StaticResource Secondary}" MinWidth="100"/>
            <Button x:Name="OkButton" Content="Valider" IsDefault="True" Click="Ok_Click" Margin="0,0,0,8" MinWidth="100"/>
        </StackPanel>
    </StackPanel>
</Window>
