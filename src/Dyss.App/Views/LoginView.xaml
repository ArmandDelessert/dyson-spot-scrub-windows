<UserControl x:Class="Dyss.App.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Dyss.App">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}" Width="460" Padding="28" Margin="16,48" HorizontalAlignment="Center" VerticalAlignment="Top">
            <StackPanel Spacing="12">
                <TextBlock Text="Connexion au compte MyDyson" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <TextBlock Style="{StaticResource Muted}"
                           Text="Pour le robot Dyson Spot+Scrub AI. Connexion avec votre compte MyDyson : un code à usage unique vous sera envoyé par e-mail."/>

                <!-- An address, not prose: no spell checking, no word suggestions. -->
                <TextBox Header="E-mail" InputScope="EmailSmtpAddress" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                         Text="{x:Bind ViewModel.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{x:Bind ViewModel.CanEditAccount, Mode=OneWay}"/>
                <!-- Where the account was created: Dyson keeps accounts per country. -->
                <ComboBox Header="Pays du compte" ItemsSource="{x:Bind ViewModel.Countries}" SelectedItem="{x:Bind ViewModel.SelectedCountry, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" IsEnabled="{x:Bind ViewModel.CanEditAccount, Mode=OneWay}"/>
                <ComboBox Header="Langue" ItemsSource="{x:Bind ViewModel.Cultures}" SelectedItem="{x:Bind ViewModel.SelectedCulture, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" IsEnabled="{x:Bind ViewModel.CanEditAccount, Mode=OneWay}"
                          ToolTipService.ToolTip="La langue des e-mails de Dyson et des noms que le robot donne aux nouvelles pièces."/>

                <Button Content="Envoyer le code" Command="{x:Bind ViewModel.SendCodeCommand}" Style="{StaticResource AccentButtonStyle}"
                        Visibility="{x:Bind ViewModel.CanEditAccount, Mode=OneWay}"/>

                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.CodeSent, Mode=OneWay}">
                    <PasswordBox x:Name="Password" Header="Mot de passe"/>
                    <TextBox Header="Code reçu par e-mail" InputScope="Number" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                             Text="{x:Bind ViewModel.OtpCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Se connecter" Click="Verify_Click" Style="{StaticResource AccentButtonStyle}"
                                IsEnabled="{x:Bind local:Ui.Not(ViewModel.Busy), Mode=OneWay}"/>
                        <Button Content="Recommencer" Command="{x:Bind ViewModel.RestartCommand}"
                                ToolTipService.ToolTip="Changer d'adresse ou de pays, ou recevoir un nouveau code."/>
                    </StackPanel>
                </StackPanel>

                <InfoBar Severity="{x:Bind local:Ui.Severity(ViewModel.MessageIsError), Mode=OneWay}" IsClosable="False"
                         Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                         IsOpen="{x:Bind local:Ui.HasText(ViewModel.Message), Mode=OneWay}"/>
                <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.Busy, Mode=OneWay}"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
