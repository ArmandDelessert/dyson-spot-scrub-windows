<UserControl x:Class="Dyss.App.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Dyss.App">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}" Width="460" Padding="28" Margin="16,48" HorizontalAlignment="Center" VerticalAlignment="Top">
            <StackPanel Spacing="12">
                <TextBlock Text='{local:Tr Fr="Connexion au compte MyDyson", En="Log in to the MyDyson account"}' Style="{StaticResource SubtitleTextBlockStyle}"/>
                <TextBlock Style="{StaticResource Muted}"
                           Text='{local:Tr Fr="Pour le robot Dyson Spot+Scrub AI. Connexion avec votre compte MyDyson : un code à usage unique vous sera envoyé par e-mail.", En="For the Dyson Spot+Scrub AI robot. Log in with your MyDyson account: a one-time code will be sent to you by e-mail."}'/>

                <!-- An address, not prose: no spell checking, no word suggestions. -->
                <TextBox Header='{local:Tr Fr="E-mail", En="E-mail"}' InputScope="EmailSmtpAddress" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                         Text="{x:Bind ViewModel.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{x:Bind ViewModel.CanEditAccount, Mode=OneWay}"/>
                <!-- Where the account was created: Dyson keeps accounts per country. -->
                <ComboBox Header='{local:Tr Fr="Pays du compte", En="Account country"}' ItemsSource="{x:Bind ViewModel.Countries}" SelectedItem="{x:Bind ViewModel.SelectedCountry, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" IsEnabled="{x:Bind ViewModel.CanEditAccount, Mode=OneWay}"/>
                <ComboBox Header='{local:Tr Fr="Langue", En="Language"}' ItemsSource="{x:Bind ViewModel.Cultures}" SelectedItem="{x:Bind ViewModel.SelectedCulture, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" IsEnabled="{x:Bind ViewModel.CanEditAccount, Mode=OneWay}"
                          ToolTipService.ToolTip='{local:Tr Fr="La langue des e-mails de Dyson et des noms que le robot donne aux nouvelles pièces.", En="The language of Dyson&apos;s e-mails and of the names the robot gives new rooms."}'/>

                <Button Content='{local:Tr Fr="Envoyer le code", En="Send the code"}' Command="{x:Bind ViewModel.SendCodeCommand}" Style="{StaticResource AccentButtonStyle}"
                        Visibility="{x:Bind ViewModel.CanEditAccount, Mode=OneWay}"/>

                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.CodeSent, Mode=OneWay}">
                    <PasswordBox x:Name="Password" Header='{local:Tr Fr="Mot de passe", En="Password"}'/>
                    <TextBox Header='{local:Tr Fr="Code reçu par e-mail", En="Code received by e-mail"}' InputScope="Number" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                             Text="{x:Bind ViewModel.OtpCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content='{local:Tr Fr="Se connecter", En="Log in"}' Click="Verify_Click" Style="{StaticResource AccentButtonStyle}"
                                IsEnabled="{x:Bind local:Ui.Not(ViewModel.Busy), Mode=OneWay}"/>
                        <Button Content='{local:Tr Fr="Recommencer", En="Start again"}' Command="{x:Bind ViewModel.RestartCommand}"
                                ToolTipService.ToolTip='{local:Tr Fr="Changer d&apos;adresse ou de pays, ou recevoir un nouveau code.", En="Change the address or country, or get a new code."}'/>
                    </StackPanel>
                </StackPanel>

                <InfoBar Severity="{x:Bind local:Ui.Severity(ViewModel.MessageIsError), Mode=OneWay}" IsClosable="False"
                         Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                         IsOpen="{x:Bind local:Ui.HasText(ViewModel.Message), Mode=OneWay}"/>
                <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.Busy, Mode=OneWay}"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
