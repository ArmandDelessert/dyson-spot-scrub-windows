<UserControl x:Class="Dyss.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Dyss.App"
             xmlns:vm="using:Dyss.Presentation.ViewModels">
    <UserControl.Resources>
        <!-- One setting: its name and what it does on the left, its control on the right. -->
        <Style x:Key="Setting" TargetType="Grid">
            <Setter Property="ColumnSpacing" Value="16"/>
            <Setter Property="Padding" Value="0,8"/>
        </Style>
        <DataTemplate x:Key="BackWashItem" x:DataType="vm:BackWashOption"><TextBlock Text="{x:Bind Label}"/></DataTemplate>
        <DataTemplate x:Key="DryItem" x:DataType="vm:DryOption"><TextBlock Text="{x:Bind Label}"/></DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="16,0,16,16" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Chaque réglage est envoyé au robot immédiatement, comme le fait l'application officielle." Style="{StaticResource Muted}" Margin="0,0,0,12"/>

            <TextBlock Text="Réglages de lavage" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Laver à l'eau chaude" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Idéal pour les nettoyages en profondeur, déconseillé pour les parquets ou stratifiés." Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.HotWaterMop, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                                      AutomationProperties.Name="Laver à l'eau chaude"/>
                    </Grid>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Laver avec le produit de nettoyage" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Votre robot lavera le sol avec le produit de nettoyage dans la station." Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.Detergent, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                                      AutomationProperties.Name="Laver avec le produit de nettoyage"/>
                    </Grid>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Produit de nettoyage" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Indique s'il reste suffisamment de produit dans la station." Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SolutionStatus, Mode=OneWay}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Prolonger les préparatifs de lavage" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Garantit une couverture de nettoyage homogène en consacrant plus de temps à la préparation sur la station d'accueil." Style="{StaticResource Caption}"/>
                            <TextBlock Text="Le robot ne communique pas encore cet état. Ce réglage reflète donc le dernier choix fait ici." Style="{StaticResource Caption}"
                                       Margin="0,2,0,0" Visibility="{x:Bind local:Ui.Unless(ViewModel.WashMopBeforeCleanKnown), Mode=OneWay}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.WashMopBeforeClean, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                                      AutomationProperties.Name="Prolonger les préparatifs de lavage"/>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="Réglages station" Style="{StaticResource Section}" Margin="0,8,0,8"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Intervalle d'auto-nettoyage" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="Définissez la fréquence à laquelle votre robot revient nettoyer son rouleau humide ou vider le collecteur pendant le nettoyage." Style="{StaticResource Caption}"/>
                            <TextBlock Text="{x:Bind ViewModel.BackWash.Description, Mode=OneWay, FallbackValue=''}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                       Visibility="{x:Bind local:Ui.IfAny(ViewModel.BackWash.Description), Mode=OneWay, FallbackValue=Collapsed}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.BackWashOptions}" SelectedItem="{x:Bind ViewModel.BackWash, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource BackWashItem}" Width="240" VerticalAlignment="Center"
                                  AutomationProperties.Name="Intervalle d'auto-nettoyage"/>
                    </Grid>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="S'autonettoie à l'eau chaude" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.HotWaterSwitch, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                                      AutomationProperties.Name="S'autonettoie à l'eau chaude"/>
                    </Grid>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Durée de séchage sur rouleau humide" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="{x:Bind ViewModel.DryDuration.Description, Mode=OneWay, FallbackValue=''}" Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.DryOptions}" SelectedItem="{x:Bind ViewModel.DryDuration, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource DryItem}" Width="240" VerticalAlignment="Center"
                                  AutomationProperties.Name="Durée de séchage"/>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="Réglages vocaux du robot" Style="{StaticResource Section}" Margin="0,8,0,8"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Activer les commandes vocales du robot" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.Alarm, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                                      AutomationProperties.Name="Activer les commandes vocales du robot"/>
                    </Grid>
                    <Grid Style="{StaticResource Setting}">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Volume" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                            <Slider Value="{x:Bind VolumeValue, Mode=TwoWay}" Minimum="0" Maximum="100" StepFrequency="10" SnapsTo="StepValues"
                                    TickFrequency="10" Width="200" VerticalAlignment="Center" AutomationProperties.Name="Volume"/>
                            <Button Content="Appliquer" Command="{x:Bind ViewModel.ApplyVolumeCommand}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
