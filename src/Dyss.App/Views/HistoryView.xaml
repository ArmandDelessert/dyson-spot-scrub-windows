<UserControl x:Class="Dyss.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Dyss.App"
             xmlns:controls="using:Dyss.App.Controls"
             xmlns:vm="using:Dyss.Presentation.ViewModels">
    <UserControl.Resources>
        <!-- The same columns for the header and the rows. -->
        <GridLength x:Key="WhenWidth">140</GridLength>
        <GridLength x:Key="DurationWidth">80</GridLength>
        <GridLength x:Key="MapWidth">130</GridLength>
        <GridLength x:Key="AreaWidth">90</GridLength>
        <GridLength x:Key="BatteryWidth">100</GridLength>
        <GridLength x:Key="FaultsWidth">56</GridLength>
    </UserControl.Resources>

    <Grid Padding="16,0,16,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="170"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>

        <!-- The cleans, newest first -->
        <Border Style="{StaticResource Card}" Padding="0,8" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid Padding="16,4,16,8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource WhenWidth}"/>
                        <ColumnDefinition Width="{StaticResource DurationWidth}"/>
                        <ColumnDefinition Width="{StaticResource WhenWidth}"/>
                        <ColumnDefinition Width="{StaticResource MapWidth}"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="{StaticResource AreaWidth}"/>
                        <ColumnDefinition Width="{StaticResource BatteryWidth}"/>
                        <ColumnDefinition Width="{StaticResource FaultsWidth}"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text='{local:Tr Fr="Date", En="Date"}' Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <TextBlock Grid.Column="1" Text='{local:Tr Fr="Durée", En="Duration"}' Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="2" Text='{local:Tr Fr="Fin", En="End"}' Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <TextBlock Grid.Column="3" Text='{local:Tr Fr="Carte", En="Map"}' Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <TextBlock Grid.Column="4" Text='{local:Tr Fr="Pièces", En="Rooms"}' Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <TextBlock Grid.Column="5" Text='{local:Tr Fr="Surface", En="Area"}' Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="6" Text='{local:Tr Fr="Batterie", En="Battery"}' Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <TextBlock Grid.Column="7" Text='{local:Tr Fr="Fautes", En="Faults"}' Style="{StaticResource BodyStrongTextBlockStyle}"/>
                </Grid>
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.History}" SelectedItem="{x:Bind ViewModel.SelectedClean, Mode=TwoWay}"
                          AutomationProperties.Name='{local:Tr Fr="Nettoyages passés", En="Past cleans"}'>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:CleanItem">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource WhenWidth}"/>
                                    <ColumnDefinition Width="{StaticResource DurationWidth}"/>
                                    <ColumnDefinition Width="{StaticResource WhenWidth}"/>
                                    <ColumnDefinition Width="{StaticResource MapWidth}"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="{StaticResource AreaWidth}"/>
                                    <ColumnDefinition Width="{StaticResource BatteryWidth}"/>
                                    <ColumnDefinition Width="{StaticResource FaultsWidth}"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind When}"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind Duration}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="2" Text="{x:Bind End}"/>
                                <TextBlock Grid.Column="3" Text="{x:Bind MapName, Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="4" Text="{x:Bind Rooms, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{x:Bind Rooms, Mode=OneWay}"/>
                                <TextBlock Grid.Column="5" Text="{x:Bind Area}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="6" Text="{x:Bind Battery}"/>
                                <TextBlock Grid.Column="7" Text="{x:Bind Faults}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- The chosen clean on its map -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Muted}">
                            <Run Text='{local:Tr Fr="Trajet du nettoyage sélectionné sur la carte ", En="Path of the selected clean on the map "}'/><Run Text="{x:Bind ViewModel.MapName, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="."/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Muted}">
                            <Run Text='{local:Tr Fr="Résultat : ", En="Result: "}'/><Run Text="{x:Bind ViewModel.ResultText, Mode=OneWay}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="1" Content='{local:Tr Fr="Réinitialiser le zoom", En="Reset zoom"}' Click="ResetZoom_Click" VerticalAlignment="Center"/>
                </Grid>
                <controls:MapView x:Name="MapCanvas" Grid.Row="1" Interaction="{x:Bind ViewModel.Canvas}"
                                  AutomationProperties.Name='{local:Tr Fr="Trajet du nettoyage sélectionné", En="Path of the selected clean"}'/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
