<Window x:Class="Dyss.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connexion au compte MyDyson" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,2,0,10"/>
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,2,0,10"/>
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="24">
        <TextBlock Text="DySS Cockpit" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Text="Pour le robot Dyson Spot+Scrub AI. Connexion avec votre compte MyDyson : un code à usage unique vous sera envoyé par e-mail." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>

        <TextBlock Text="E-mail"/>
        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CodeSent, Converter={StaticResource Not}}"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Pays (ISO)"/>
                <TextBox Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CodeSent, Converter={StaticResource Not}}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Culture"/>
                <TextBox Text="{Binding Culture, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CodeSent, Converter={StaticResource Not}}"/>
            </StackPanel>
        </Grid>

        <Button Content="Envoyer le code" Command="{Binding SendCodeCommand}" HorizontalAlignment="Left"
                Visibility="{Binding CodeSent, Converter={StaticResource Collapse}}"/>

        <StackPanel Visibility="{Binding CodeSent, Converter={StaticResource Show}}">
            <TextBlock Text="Mot de passe"/>
            <PasswordBox x:Name="Password"/>
            <TextBlock Text="Code reçu par e-mail"/>
            <TextBox Text="{Binding OtpCode, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="Se connecter" Click="Verify_Click" HorizontalAlignment="Left"/>
        </StackPanel>

        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,14,0,0"/>
        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,10,0,0" Visibility="{Binding Busy, Converter={StaticResource Show}}"/>
    </StackPanel>
</Window>
