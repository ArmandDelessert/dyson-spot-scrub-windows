<UserControl x:Class="Dyss.App.Views.MapManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Dyss.App"
             xmlns:controls="using:Dyss.App.Controls"
             xmlns:core="using:Dyss.Core"
             xmlns:vm="using:Dyss.Presentation.ViewModels">
    <UserControl.Resources>
        <!-- Rows that can be clicked rather than selected: a click means "choose" or "gather for a
             merge" depending on the mode, which list selection would fight. What is chosen gets
             the selection colour behind it. -->
        <Style x:Key="ClickableRow" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>
        <DataTemplate x:Key="OrientationItem" x:DataType="vm:OrientationOption"><TextBlock Text="{x:Bind Label}"/></DataTemplate>
    </UserControl.Resources>

    <Grid Padding="16,0,16,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Maps -->
            <Border Style="{StaticResource Card}" Margin="0" Padding="12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text='{local:Tr Fr="Cartes", En="Maps"}' Style="{StaticResource Section}" Margin="4,0,0,0"/>
                    <!-- A double click makes the map active. The first click has already selected
                         it, and the command stays disabled on the active map. -->
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Maps}" SelectedItem="{x:Bind ViewModel.SelectedMap, Mode=TwoWay}"
                              ItemTemplate="{StaticResource MapItemName}" DoubleTapped="Maps_DoubleTapped"
                              AutomationProperties.Name='{local:Tr Fr="Cartes du compte", En="Maps of the account"}'/>
                    <StackPanel Grid.Row="2">
                        <Button Content='{local:Tr Fr="Définir comme active", En="Make active"}' Command="{x:Bind ViewModel.SetActiveCommand}" Style="{StaticResource PanelButton}"/>
                        <Button Content='{local:Tr Fr="Renommer la carte…", En="Rename the map…"}' Command="{x:Bind ViewModel.RenameMapCommand}" Style="{StaticResource PanelButton}"/>
                        <Button Content='{local:Tr Fr="Supprimer la carte…", En="Delete the map…"}' Command="{x:Bind ViewModel.DeleteMapCommand}" Style="{StaticResource PanelButton}"/>
                        <Button Content='{local:Tr Fr="Nouvelle carte (scan)…", En="New map (scan)…"}' Command="{x:Bind ViewModel.StartMappingCommand}" Style="{StaticResource PanelButton}"/>
                        <!-- Picking another orientation turns the map at once, here and on the phone. -->
                        <ComboBox Header='{local:Tr Fr="Orientation de la carte", En="Map orientation"}' ItemsSource="{x:Bind ViewModel.MapOrientations}"
                                  SelectedItem="{x:Bind ViewModel.MapOrientation, Mode=TwoWay}" ItemTemplate="{StaticResource OrientationItem}"
                                  IsEnabled="{x:Bind ViewModel.CanRotateMap, Mode=OneWay}" HorizontalAlignment="Stretch" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Map -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0" Padding="12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{x:Bind ViewModel.Hint, Mode=OneWay}" Style="{StaticResource Caption}"/>
                    <!-- Why the edit buttons are greyed out on any map but the active one. -->
                    <InfoBar Grid.Row="1" Severity="Informational" IsClosable="False" Message="{x:Bind ViewModel.EditBlockedReason, Mode=OneWay}"
                             IsOpen="{x:Bind local:Ui.HasText(ViewModel.EditBlockedReason), Mode=OneWay}"/>
                    <controls:MapView x:Name="MapCanvas" Grid.Row="2" Interaction="{x:Bind ViewModel.Canvas}"
                                      AutomationProperties.Name='{local:Tr Fr="Carte en cours de modification", En="Map being edited"}'/>
                </Grid>
            </Border>

            <!-- Rooms, zones, furniture: one tab each. The tab on show decides what a click on the
                 map chooses; the tabs stay put while something is being sent. -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="12">
                <Grid RowSpacing="8" IsHitTestVisible="{x:Bind local:Ui.Not(ViewModel.Busy), Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <SelectorBar x:Name="Layers" SelectionChanged="Layers_SelectionChanged">
                        <SelectorBarItem Text='{local:Tr Fr="Pièces", En="Rooms"}'/>
                        <SelectorBarItem Text='{local:Tr Fr="Zones", En="Zones"}'/>
                        <SelectorBarItem Text='{local:Tr Fr="Meubles", En="Furniture"}'/>
                    </SelectorBar>

                    <!-- Rooms -->
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Rooms}" SelectionMode="None" IsItemClickEnabled="True"
                              ItemClick="Room_Click" ItemContainerStyle="{StaticResource ClickableRow}"
                              Visibility="{x:Bind local:Ui.IsLayer(ViewModel.LayerIndex, 0), Mode=OneWay}" AutomationProperties.Name='{local:Tr Fr="Pièces de la carte", En="Rooms of the map"}'>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ManagedRoom">
                                <Grid>
                                    <Border Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="4" Opacity="0.35"
                                            Visibility="{x:Bind IsChosen, Mode=OneWay}"/>
                                    <Grid Padding="10,6" ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock TextTrimming="CharacterEllipsis">
                                            <Run Text="{x:Bind DisplayName}"/>
                                            <Run Text="{x:Bind TypeText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Text="{x:Bind AreaText}" Style="{StaticResource Muted}"/>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="2" Visibility="{x:Bind local:Ui.IsLayer(ViewModel.LayerIndex, 0), Mode=OneWay}">
                        <Button Content='{local:Tr Fr="Renommer la pièce…", En="Rename the room…"}' Command="{x:Bind ViewModel.RenameRoomCommand}" Style="{StaticResource PanelButton}"/>
                        <!-- "Diviser" and "Fusionner" are the phone app's own words. -->
                        <Button Content='{local:Tr Fr="Diviser la pièce…", En="Split the room…"}' Command="{x:Bind ViewModel.StartSplitCommand}" Style="{StaticResource PanelButton}"/>
                        <!-- One button, two presses: the first starts gathering rooms, the second
                             merges them. Its label says which press is next. -->
                        <Button Content="{x:Bind ViewModel.MergeButtonLabel, Mode=OneWay}" Command="{x:Bind ViewModel.MergeCommand}" Style="{StaticResource PanelButton}"/>
                        <Button Content='{local:Tr Fr="Annuler", En="Cancel"}' Command="{x:Bind ViewModel.CancelCommand}" Style="{StaticResource PanelButton}"
                                Visibility="{x:Bind ViewModel.InMode, Mode=OneWay}"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                   Text='{local:Tr Fr="Une division suit toujours un trait droit que le robot recale sur sa propre grille, et les deux moitiés perdent leur nom. Pour faire disparaître une pièce, fusionnez-la avec sa voisine.", En="A split always follows a straight line that the robot snaps to its own grid, and both halves lose their name. To get rid of a room, merge it with its neighbour."}'/>
                    </StackPanel>

                    <!-- Restriction zones -->
                    <Grid Grid.Row="1" Visibility="{x:Bind local:Ui.IsLayer(ViewModel.LayerIndex, 1), Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{x:Bind ViewModel.ZonesEmptyText, Mode=OneWay}" Style="{StaticResource Muted}" Margin="6,4"
                                   Visibility="{x:Bind local:Ui.IfAny(ViewModel.ZonesEmptyText), Mode=OneWay}"/>
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.RestrictionZones}" SelectionMode="None" IsItemClickEnabled="True"
                                  ItemClick="Zone_Click" ItemContainerStyle="{StaticResource ClickableRow}" AutomationProperties.Name='{local:Tr Fr="Zones de la carte", En="Zones of the map"}'>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ManagedZone">
                                    <Grid>
                                        <Border Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="4" Opacity="0.35"
                                                Visibility="{x:Bind IsChosen, Mode=OneWay}"/>
                                        <Grid Padding="10,6" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- The zone's colour on the map, which doubles as the legend. -->
                                            <Border Width="12" Height="12" CornerRadius="2" Background="{x:Bind local:Ui.Brush(Swatch)}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Label}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" Style="{StaticResource Muted}"/>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                    <StackPanel Grid.Row="2" Visibility="{x:Bind local:Ui.IsLayer(ViewModel.LayerIndex, 1), Mode=OneWay}">
                        <ComboBox Header='{local:Tr Fr="Type de zone", En="Zone type"}' ItemsSource="{x:Bind ViewModel.ZoneKinds}" SelectedItem="{x:Bind ViewModel.ZoneKind, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" Margin="0,0,0,8">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="core:RestrictionKind">
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Label}"/>
                                        <TextBlock Text="{x:Bind Effect}" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content='{local:Tr Fr="Ajouter une zone…", En="Add a zone…"}' Command="{x:Bind ViewModel.AddZoneCommand}" Style="{StaticResource PanelButton}"/>
                        <Button Content='{local:Tr Fr="Changer le type de la zone", En="Change the zone&apos;s type"}' Command="{x:Bind ViewModel.ChangeZoneKindCommand}" Style="{StaticResource PanelButton}"/>
                        <Button Content='{local:Tr Fr="Supprimer la zone…", En="Delete the zone…"}' Command="{x:Bind ViewModel.DeleteZoneCommand}" Style="{StaticResource PanelButton}"/>
                        <CheckBox IsChecked="{x:Bind ViewModel.SnapToGrid, Mode=TwoWay}" Content='{local:Tr Fr="Caler sur la grille de 5 cm", En="Snap to the 5 cm grid"}'
                                  ToolTipService.ToolTip='{local:Tr Fr="Les zones et les meubles se calent sur la grille du robot quand on les trace, les pose ou les déplace ; la grille s&apos;affiche en zoomant.", En="Zones and furniture snap to the robot&apos;s grid when drawn, placed or moved; the grid shows when zoomed in."}'/>
                        <Button Content='{local:Tr Fr="Annuler", En="Cancel"}' Command="{x:Bind ViewModel.CancelCommand}" Style="{StaticResource PanelButton}"
                                Visibility="{x:Bind ViewModel.InMode, Mode=OneWay}"/>
                        <TextBlock Text="{x:Bind ViewModel.ZonesBlockedReason, Mode=OneWay}" Style="{StaticResource Warning}" Margin="0,4,0,0"
                                   Visibility="{x:Bind local:Ui.IfAny(ViewModel.ZonesBlockedReason), Mode=OneWay}"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                   Text='{local:Tr Fr="Une zone est un rectangle droit, comme dans l&apos;application mobile. Faites glisser la zone choisie pour la déplacer, ou tirez un de ses coins pour la redimensionner. Le robot reçoit toujours la liste entière des zones de la carte.", En="A zone is an upright rectangle, as in the mobile app. Drag the chosen zone to move it, or pull one of its corners to resize it. The robot always receives the map&apos;s whole list of zones."}'/>
                    </StackPanel>

                    <!-- Furniture -->
                    <Grid Grid.Row="1" Visibility="{x:Bind local:Ui.IsLayer(ViewModel.LayerIndex, 2), Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{x:Bind ViewModel.FurnitureEmptyText, Mode=OneWay}" Style="{StaticResource Muted}" Margin="6,4"
                                   Visibility="{x:Bind local:Ui.IfAny(ViewModel.FurnitureEmptyText), Mode=OneWay}"/>
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.FurnitureItems}" SelectionMode="None" IsItemClickEnabled="True"
                                  ItemClick="Furniture_Click" ItemContainerStyle="{StaticResource ClickableRow}" AutomationProperties.Name='{local:Tr Fr="Meubles de la carte", En="Furniture of the map"}'>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ManagedFurniture">
                                    <Grid>
                                        <Border Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="4" Opacity="0.35"
                                                Visibility="{x:Bind IsChosen, Mode=OneWay}"/>
                                        <Grid Padding="10,6" ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind SizeText}" Style="{StaticResource Muted}"/>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                    <StackPanel Grid.Row="2" Visibility="{x:Bind local:Ui.IsLayer(ViewModel.LayerIndex, 2), Mode=OneWay}">
                        <ComboBox Header='{local:Tr Fr="Meuble à ajouter", En="Furniture to add"}' ItemsSource="{x:Bind ViewModel.FurnitureKinds}" SelectedItem="{x:Bind ViewModel.FurnitureKind, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" Margin="0,0,0,8">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="core:FurnitureKind">
                                    <TextBlock>
                                        <Run Text="{x:Bind Category}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <Run Text="·" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <Run Text="{x:Bind Label}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content='{local:Tr Fr="Ajouter ce meuble…", En="Add this piece…"}' Command="{x:Bind ViewModel.AddFurnitureCommand}" Style="{StaticResource PanelButton}"/>
                        <!-- The chosen piece's orientation: picking another turns it at once. -->
                        <ComboBox Header='{local:Tr Fr="Orientation du meuble choisi", En="Orientation of the chosen piece"}' ItemsSource="{x:Bind ViewModel.Orientations}"
                                  SelectedItem="{x:Bind ViewModel.FurnitureOrientation, Mode=TwoWay}" ItemTemplate="{StaticResource OrientationItem}"
                                  IsEnabled="{x:Bind ViewModel.CanOrientFurniture, Mode=OneWay}" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                        <Button Content='{local:Tr Fr="Retirer le meuble…", En="Remove the piece…"}' Command="{x:Bind ViewModel.DeleteFurnitureCommand}" Style="{StaticResource PanelButton}"/>
                        <CheckBox IsChecked="{x:Bind ViewModel.SnapToGrid, Mode=TwoWay}" Content='{local:Tr Fr="Caler sur la grille de 5 cm", En="Snap to the 5 cm grid"}'
                                  ToolTipService.ToolTip='{local:Tr Fr="Les zones et les meubles se calent sur la grille du robot quand on les trace, les pose ou les déplace ; la grille s&apos;affiche en zoomant.", En="Zones and furniture snap to the robot&apos;s grid when drawn, placed or moved; the grid shows when zoomed in."}'/>
                        <Button Content='{local:Tr Fr="Annuler", En="Cancel"}' Command="{x:Bind ViewModel.CancelCommand}" Style="{StaticResource PanelButton}"
                                Visibility="{x:Bind ViewModel.InMode, Mode=OneWay}"/>
                        <TextBlock Text="{x:Bind ViewModel.FurnitureBlockedReason, Mode=OneWay}" Style="{StaticResource Warning}" Margin="0,4,0,0"
                                   Visibility="{x:Bind local:Ui.IfAny(ViewModel.FurnitureBlockedReason), Mode=OneWay}"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                   Text='{local:Tr Fr="Un meuble est posé à la taille que lui donne l&apos;application mobile. Faites glisser le meuble choisi pour le déplacer. Le robot reçoit toujours la liste entière des meubles de la carte.", En="A piece of furniture is placed at the size the mobile app gives it. Drag the chosen piece to move it. The robot always receives the map&apos;s whole list of furniture."}'/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Status strip -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <ProgressBar Grid.Column="1" Width="120" IsIndeterminate="True" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.Busy, Mode=OneWay}"/>
        </Grid>
    </Grid>
</UserControl>
