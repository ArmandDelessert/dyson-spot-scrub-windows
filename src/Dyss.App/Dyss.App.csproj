<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Dyss.Core\Dyss.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- The executable is named after the application; the code keeps the project's namespace. -->
    <AssemblyName>DyssCockpit</AssemblyName>
    <RootNamespace>Dyss.App</RootNamespace>
    <!-- The robot heading down with its light on, written by DyssCockpit.exe with its export-icon
         option (see Rendering/AppIcon.cs). The windows, the taskbar and the notifications take it from here. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- UseWindowsForms implicitly adds global usings for System.Windows.Forms/System.Drawing,
       which collide project-wide with WPF's System.Windows types (Point, Size, Color...). Only
       NotificationService.cs needs WinForms, so it keeps its own explicit usings instead. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
