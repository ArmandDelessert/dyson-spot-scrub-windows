<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- What both test projects share (tests\TestSupport): the robot that records what it is sent,
         the clocks, the protobuf writer, the wait for what comes a moment later. -->
    <Compile Include="..\TestSupport\*.cs" LinkBase="TestSupport" />
    <Using Include="DyssCockpit.TestSupport" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DyssCockpit.Core\DyssCockpit.Core.csproj" />
  </ItemGroup>

</Project>
